{
  "name": "iron-lsp",
  "displayName": "Iron LSP",
  "description": "Iron language support for VSCode via ironls (LSP 3.17) with TextMate syntax highlighting.",
  "publisher": "iron-lang",
  "version": "4.12.0-alpha",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/iron-lang/iron-lang"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:iron",
    "workspaceContains:**/iron.toml",
    "onDebugResolve:iron",
    "onDebugDynamicConfigurations:iron"
  ],
  "main": "./dist/extension.js",
  "ironLspCompatibleIronlsRange": ">= 4.0.0, < 5.0.0",
  "contributes": {
    "languages": [
      {
        "id": "iron",
        "extensions": [".iron"],
        "aliases": ["Iron", "iron"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iron",
        "scopeName": "source.iron",
        "path": "./syntaxes/iron.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "iron",
        "path": "./snippets/iron.code-snippets"
      }
    ],
    "breakpoints": [
      {
        "language": "iron"
      }
    ],
    "debuggers": [
      {
        "type": "iron",
        "label": "Iron",
        "languages": ["iron"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "A .iron file or a package directory (built with `iron build --debug` first), or a binary that is already built.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program (default: the file's directory, or the package)."
              },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "Environment variables for the program.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the start of the program.",
                "default": false
              },
              "stopOnPanic": {
                "type": "boolean",
                "description": "Stop on the Iron line when the program panics (failed assert, index out of bounds).",
                "default": true
              },
              "build": {
                "type": "boolean",
                "description": "Build .iron files and packages with --debug before debugging.",
                "default": true
              },
              "test": {
                "type": "string",
                "description": "The name of a `test \"...\"` block in `program` (a .iron file): only that test runs, built with --test."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "iron",
            "request": "launch",
            "name": "Iron: debug this file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Iron: debug a file",
            "description": "Build the open .iron file with --debug and debug it.",
            "body": { "type": "iron", "request": "launch", "name": "Iron: debug this file", "program": "^\"\\${file}\"" }
          },
          {
            "label": "Iron: debug the package",
            "description": "Build the package with iron build --debug and debug it.",
            "body": { "type": "iron", "request": "launch", "name": "Iron: debug the package", "program": "^\"\\${workspaceFolder}\"", "args": [] }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Iron LSP",
      "properties": {
        "iron.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the ironls binary. When empty, the extension searches PATH via which/where. See UI-SPEC S4."
        },
        "iron.languageServer.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces LSP communication between VSCode and ironls. When not 'off', messages appear in the 'Iron Language Server (trace)' output channel."
        },
        "iron.debug.ironPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `iron` CLI the iron debug type runs (`iron dap`, and the --debug build). When empty, the extension searches PATH."
        },
        "iron.languageServer.logLevel": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"],
          "default": "info",
          "description": "Minimum severity for Iron LSP editor-side log events (ext.activate, ironls.discovered, lsp.initialize.*)."
        },
        "iron.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter names before the arguments of a call, as in area(w: 2, h: 3)."
        },
        "iron.inlayHints.bindingTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred type after a val or var written without one, as in val n: Int = 3."
        }
      }
    },
    "commands": [
      {
        "command": "iron-lsp.diagnose",
        "title": "Iron LSP: Diagnose",
        "category": "Iron LSP"
      },
      {
        "command": "iron.runFile",
        "title": "Run Iron File",
        "category": "Iron",
        "icon": "$(play)"
      },
      {
        "command": "iron.debugFile",
        "title": "Debug Iron File",
        "category": "Iron",
        "icon": "$(debug-alt)"
      },
      {
        "command": "iron.runTest",
        "title": "Run Test",
        "category": "Iron"
      },
      {
        "command": "iron.debugTest",
        "title": "Debug Test",
        "category": "Iron"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "iron.runFile",
          "when": "resourceLangId == iron",
          "group": "navigation@1"
        },
        {
          "command": "iron.debugFile",
          "when": "resourceLangId == iron",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "iron.runFile",
          "when": "editorLangId == iron"
        },
        {
          "command": "iron.debugFile",
          "when": "editorLangId == iron"
        },
        {
          "command": "iron.runTest",
          "when": "false"
        },
        {
          "command": "iron.debugTest",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "prepackage": "node prepackage.mjs",
    "compile": "tsc -p . --noEmit",
    "package": "npm run prepackage && npm run bundle && vsce package --no-dependencies",
    "publish": "npm run prepackage && npm run bundle && vsce publish --no-dependencies",
    "pretest:e2e": "tsc -p . --outDir out",
    "test:e2e": "npm run prepackage && npm run bundle && node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.92.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.28.1",
    "glob": "^11.0.0",
    "mocha": "^12.0.3",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12"
  }
}
