-- A diagnostic inside a generic instance points at the template's line
-- (#594): it named a line of the printed instance, often a blank one.
object Hold[T] {
    var items: [T]

    init() {
        self.items = []
    }

    func put(x: T) {
        self.items.push(x)
    }
}

object Inner {
    var xs: [Int]

    init() {
        self.xs = []
    }
}

func main() {
    var h = Hold[Inner]()
    h.put(Inner())
}
