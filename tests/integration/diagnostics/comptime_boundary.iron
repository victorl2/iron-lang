-- Constructs compile-time evaluation leaves out (manual 8) are E0231, the
-- unsupported-construct code, like method calls and interpolation: they
-- were E0232 ("comptime error") with messages such as "function not found
-- in global scope" or "unresolved identifier".
val BASE = 7

object Counter {
    var n: Int
    init(n: Int) {
        self.n = n
    }
}

func bits(n: Int) -> Int {
    return n & 3
}

func conv(n: Int) -> Int {
    val f = Float(n)
    return Int(f)
}

func reads_global(n: Int) -> Int {
    return n + BASE
}

func joins(n: Int) -> Int {
    val s = "a" + "b"
    return len(s) + n
}

func builds(n: Int) -> Int {
    val c = Counter(n)
    return n
}

val A = comptime bits(1)
val B = comptime conv(2)
val C = comptime reads_global(3)
val D = comptime joins(4)
val E = comptime builds(5)

func main() {
    println("{A} {B} {C} {D} {E}")
}
