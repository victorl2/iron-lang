-- section 4.11 pointer-check elision: free-and-reassign soundness trap
-- @req: OPT-03, OQ-08
-- @expect-panic: stale pointer dereference
-- A generation check straddles a free of the binding a pointer was taken
-- into, followed by a fresh allocation in the same binding. The check is
-- preserved across the free and fires on the deref of the stale pointer.

object Resource {
    val id: Int
}

func main() {
    var current = heap Resource(1)
    val ptr: *Resource = &current
    println("first: {ptr.id}")
    -- release the first resource and put a new one in the same binding
    free current
    current = heap Resource(2)
    println("second: {current.id}")
    -- stale deref: the original Resource was freed; the check must fire
    println("stale: {ptr.id}")
}
