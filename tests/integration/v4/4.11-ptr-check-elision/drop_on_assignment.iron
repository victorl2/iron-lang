-- section 4.11 pointer-check elision: drop-on-assignment soundness trap
-- @req: OPT-03, OQ-08
-- @expect-panic: stale pointer dereference
-- @expected-pass-after: phase-38
-- XFAIL (phase-38): `heap T` type annotations not in the v4 surface (heap is allocation-expression-only).
-- extends-spec: POINTER-CHECK-ELISION.md soundness trap "drop on assignment" —
-- a generation check straddles a store into an owning slot. A naive elision
-- that reused the first check's result for the post-assignment deref would be
-- unsound: assigning a new owner runs `drop` on the previous occupant, freeing
-- the allocation the pointer still references. Store-to-owning-slot is a
-- may-free barrier, so the check is PRESERVED and fires on the stale deref.

object Resource {
    val id: Int
}

object Owner {
    var current: heap Resource
    init(r: heap Resource) {
        self.current = r
    }
}

func main() {
    val owner = Owner(heap Resource(1))
    -- pointer into the currently-owned resource
    val ptr: *Resource = &owner.current
    println("first: {ptr.id}")
    -- overwrite the owning slot: the previous Resource is dropped/freed
    owner.current = heap Resource(2)
    -- stale deref: the original Resource was freed by the assignment
    println("stale: {ptr.id}")
}
