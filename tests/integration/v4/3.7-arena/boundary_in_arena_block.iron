-- section 3.7 arena allocation: in arena {} block
-- @req: ARENA-01, ARENA-04
-- @expected-pass-after: phase-28
-- extends-spec: in arena {} block sets default arena for bare heap T(...) inside

object Particle {
    val x: Int
    val y: Int
}

func main() {
    val frame_arena = Arena.with_capacity(65536)
    in frame_arena {
        val p1 = heap Particle(x: 10, y: 20)
        val p2 = heap Particle(x: 30, y: 40)
        println("p1: ({p1.x},{p1.y})")
        println("p2: ({p2.x},{p2.y})")
    }
    println("block done")
}
