-- section 3.7 arena allocation: Arena.with_capacity preallocates backing buffer
-- @req: ARENA-01
-- @expected-pass-after: phase-28
-- extends-spec: Arena.with_capacity preallocates the underlying buffer; used/capacity reported correctly
-- (construction is positional — named args are not a surface form)

object Block {
    val data: Int
}

func main() {
    val arena = Arena.with_capacity(4096)
    println("capacity: {arena.capacity()}")
    println("used before: {arena.used()}")
    val b1 = heap(in: arena) Block(1)
    val b2 = heap(in: arena) Block(2)
    val b3 = heap(in: arena) Block(3)
    println("used after 3 allocs > 0: {arena.used() > 0}")
    println("data: {b1.data},{b2.data},{b3.data}")
}
