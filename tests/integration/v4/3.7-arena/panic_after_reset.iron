-- section 3.7 arena allocation: use-after-reset panic
-- @req: ARENA-06, SAFE-05
-- @expected-pass-after: phase-28
-- @expect-panic: dangling pointer to arena-reset memory
-- extends-spec: pointer to arena-allocated value is dangling after arena.reset()

object DrawCmd {
    val id: Int
}

func main() {
    val arena = Arena.with_capacity(4096)
    val cmd = heap(in: arena) DrawCmd(42)
    val ptr: *DrawCmd = &cmd
    arena.reset()
    println("id: {ptr.id}")
}
