-- section 3.7 arena allocation
-- @req: ARENA-01, ARENA-03
-- @expected-pass-after: phase-28
-- canonical Arena.with_capacity + heap(in: arena) allocations; allow_drop_skip: true
-- acknowledges that the arena bulk-frees without running DrawCmd's drop (ARENA-09/W0605)
-- — matching the .expected output, which has no "drop cmd" lines.
-- (construction is positional — named args are not a surface form)

object DrawCmd {
    val id: Int

    drop {
        println("drop cmd: {self.id}")
    }
}

func main() {
    val frame_arena = Arena.with_capacity(65536)
    val cmd1 = heap(in: frame_arena, allow_drop_skip: true) DrawCmd(1)
    val cmd2 = heap(in: frame_arena, allow_drop_skip: true) DrawCmd(2)
    val cmd3 = heap(in: frame_arena, allow_drop_skip: true) DrawCmd(3)
    println("cmds: {cmd1.id}, {cmd2.id}, {cmd3.id}")
}
