-- section 8.3 extends-spec: ATOMIC-ELISION.md soundness barrier probe
-- @req: POL-06, POL-07
-- extends-spec: spawn worker holding rc copy; main awaits; drop fires exactly once

object SharedState {
    val value: Int

    drop {
        println("shared state dropped")
    }
}

func worker(s: rc SharedState) {
    -- worker holds its own rc copy for the duration of the task
    println("worker value: {s.value}")
    -- s drops at worker function exit; refcount decrements
}

func main() {
    val state = rc SharedState(42)
    val worker_copy = state         -- refcount = 2
    val t = spawn("worker") { worker(worker_copy) }  -- the task holds the copy
    await t                         -- deterministic output order
    -- main's rc copy still alive here; refcount >= 1
    println("main continues")
    -- state drops at main exit; refcount reaches 0; destructor fires once
}
