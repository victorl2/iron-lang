-- section 8.3 extends-spec: drop-ordering probe for rc shared texture
-- @req: POL-06, POL-07, DROP-01
-- @expected-pass-after: phase-26
-- extends-spec: 3 rc copies in nested scopes; destructor fires after last reference released
-- (.expected reordered: the last strong ref `a` is released at MAIN SCOPE EXIT — after the final
-- println — per scope-exit drop semantics; the old ordering assumed eager last-use release, which
-- is not an Iron surface and contradicted the 3.3-rc sibling corpus)

object Resource {
    val id: Int

    drop {
        println("drop resource {self.id}")
    }
}

func main() {
    val a = rc Resource(1)
    println("a alive")
    {
        val b = a                  -- refcount = 2
        println("b alive")
        {
            val c = a              -- refcount = 3
            println("c alive")
            -- c drops here; refcount = 2; no destructor
        }
        println("c gone")
        -- b drops here; refcount = 1; no destructor
    }
    println("b gone")
    println("a gone")
    -- a drops at main scope exit; refcount = 0; destructor fires last
}
