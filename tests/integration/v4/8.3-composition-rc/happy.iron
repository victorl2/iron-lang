-- section 8.3 rc shared resources: AssetManager + Sprite
-- @req: POL-06, POL-07
-- rc Texture shared across sprites; copies retain; drop fires once at the last release

object Texture {
    val path: String

    drop {
        println("freeing: {self.path}")
    }
}

object AssetManager {
    var paths: [String]
    var textures: [rc Texture]

    init() {
        self.paths = []
        self.textures = []
    }

    func load_texture(path: String) -> rc Texture {
        var i = 0
        while i < self.paths.len() {
            if self.paths[i] == path {
                return self.textures[i]
            }
            i = i + 1
        }
        val tex = rc Texture(path)
        self.paths.push(path)
        self.textures.push(tex)
        println("loaded: {path}")
        return tex
    }
}

object Vec2 {
    val x: Float
    val y: Float
}

object Sprite {
    var pos: Vec2
    val texture: rc Texture

    init(pos: Vec2, texture: rc Texture) {
        self.pos = pos
        self.texture = texture
    }
}

func main() {
    var assets = AssetManager()
    val tex1 = assets.load_texture("hero.png")
    val tex2 = assets.load_texture("hero.png")
    val hero = Sprite(Vec2(0.0, 0.0), tex1)
    val shadow = Sprite(Vec2(1.0, 1.0), tex2)
    println("sprites at {hero.pos.x} and {shadow.pos.x} share {hero.texture.path}")
}
