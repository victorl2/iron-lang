-- section 4.12 debug-leak: 'defer free' satisfies forgotten-free (DBG-05)
-- @req: DBG-05
-- @expected-pass-after: phase-31
-- A heap binding with a reaching 'defer free' counts as freed and must NOT
-- raise W0606. The CTest inverts the grep (W0606 must be ABSENT).

object Point { var x: Int; var y: Int }

func main() {
    val p = heap Point(1, 2)
    defer free p
    println("x: {p.x}")
}
