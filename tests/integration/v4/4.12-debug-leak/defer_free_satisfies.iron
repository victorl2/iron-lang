-- section 4.12 debug-leak: 'defer free' satisfies forgotten-free (DBG-05)
-- @req: DBG-05
-- @expected-pass-after: phase-31
-- A heap binding with a reaching 'defer free' counts as freed and must NOT
-- raise W0606. The W0606-ABSENT contract is pinned by the dedicated ctest row
-- (v4_4.12-debug-leak_defer_free_satisfies: inverted grep on ironc check).
-- The aggregate run-and-compare handler cannot observe compile-time warnings,
-- so .expected pins the runtime stdout.

object Point {
    val x: Int
    val y: Int
}

func main() {
    val p = heap Point(1, 2)
    defer free p
    println("x: {p.x}")
}
