-- section 4.12 debug-leak: 'leak' suppresses forgotten-free (DBG-05 / POL-05)
-- @req: DBG-05
-- @expected-pass-after: phase-31
-- A heap binding marked as an intentional leak via the 'leak p' statement
-- must NOT raise W0606. The W0606-ABSENT contract is pinned by the dedicated
-- ctest row (v4_4.12-debug-leak_leak_suppresses: inverted grep on ironc
-- check). The aggregate run-and-compare handler cannot observe compile-time
-- warnings, so .expected pins the runtime stdout. Note: 'leak' is a statement
-- ('leak p', see 3.2-heap/boundary_leak), not an expression prefix.

object Point {
    val x: Int
    val y: Int
}

func main() {
    val p = heap Point(1, 2)
    leak p
    println("x: {p.x}")
}
