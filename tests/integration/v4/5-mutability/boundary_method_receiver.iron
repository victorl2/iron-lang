-- section: 5-mutability
-- @req: PARM-01, PARM-04
-- extends-spec: method receiver mutability is part of method signature; PARM-04: method receiver default is mutable; readonly opts out; object has both readonly get and mutating tick methods

object Counter {
    var count: Int

    init(count: Int) {
        self.count = count
    }

    readonly func get() -> Int {
        return self.count
    }

    func tick() {
        self.count = self.count + 1
    }
}

func main() {
    var c = Counter(0)
    c.tick()
    c.tick()
    println("count={c.get()}")
}
