-- section: 5-mutability
-- @req: VAL-02
-- @expected-pass-after: phase-17
-- extends-spec: object field declared var allows mutation through *var receiver; VAL-02 requires every field to declare val or var explicitly

object Counter {
    var count: Int

    func increment(self: *var Counter) {
        self.count = self.count + 1
    }
}

func main() {
    var c = Counter(count: 0)
    c.increment()
    c.increment()
    c.increment()
    println("count={c.count}")
}
