-- section 5.5 positive: var parameter never mutated (warning expected; runtime stdout asserted)
-- @req: VAL-06
-- @expected-pass-after: phase-17

func greet(var name: String) {
    println("Hi, {name}")
}

func main() {
    -- E0267: a 'var' parameter requires a mutable argument source (the
    -- language definition makes var params mutable references), so the
    -- literal is bound to a var first.
    var world = "World"
    greet(world)
}
