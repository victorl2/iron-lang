-- section 8.4 extends-spec: cycle-break proof with 3-node parent/child chain
-- @req: POL-08, POL-09, DROP-01
-- extends-spec: parent->child is rc (owning); child->parent is weak (non-owning)
-- all 3 nodes must be freed because weak refs do not prevent collection.
-- A node's drop body runs before its fields are released, so the chain
-- drops from the root down.

object Node {
    val id: Int
    var children: [rc Node]
    var parent: weak rc Node

    init(id: Int) {
        self.id = id
        self.children = []
        self.parent = weak rc null
    }

    drop {
        println("drop node {self.id}")
    }
}

func add_child(parent: rc Node, child: rc Node) {
    child.parent = parent.downgrade()
    parent.children.push(child)
}

func main() {
    val n1 = rc Node(1)
    val n2 = rc Node(2)
    val n3 = rc Node(3)

    add_child(n1, n2)
    add_child(n2, n3)

    println("chain built")
    -- n1 owns n2 (rc); n2 owns n3 (rc); the parent links are weak.
    -- n3 and n2 lose their bindings first but stay alive through their
    -- parents; n1 then drops and takes the chain with it.
}
