-- section 8.4 extends-spec: cycle-break proof with 3-node parent/child chain
-- @req: POL-08, POL-09, DROP-01
-- @expected-pass-after: phase-27
-- extends-spec: parent->child is rc (owning); child->parent is weak (non-owning)
-- all 3 nodes must be freed because weak refs do not prevent collection

object Node {
    val id: Int
    var children: List[rc Node]
    var parent: weak rc Node

    init(id: Int) {
        self.id = id
        self.children = List.new()
        self.parent = weak rc null
    }

    func add_child(self: *var Node, child: rc Node) {
        child.parent = weak rc self
        self.children.add(child)
    }

    drop {
        println("drop node {id}")
    }
}

func main() {
    val n1 = rc Node(id: 1)
    val n2 = rc Node(id: 2)
    val n3 = rc Node(id: 3)

    n1.add_child(n2)
    n2.add_child(n3)

    println("chain built")
    -- n1 owns n2 (rc); n2 owns n3 (rc)
    -- n2.parent = weak rc n1; n3.parent = weak rc n2
    -- when n1 drops -> n2 drops -> n3 drops; all 3 freed
}
