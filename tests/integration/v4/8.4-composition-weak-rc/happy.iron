-- section 8.4 weak rc parent/child Node graph
-- @req: POL-08, POL-09
-- parent->child is rc (owning); child->parent is weak rc (non-owning); no cycle

object Mat4 {
    val m00: Float

    readonly func mul(other: Mat4) -> Mat4 {
        return Mat4(self.m00 * other.m00)
    }
}

object SceneNode {
    var transform: Mat4
    var children: [rc SceneNode]
    var parent: weak rc SceneNode

    init(transform: Mat4) {
        self.transform = transform
        self.children = []
        self.parent = weak rc null
    }

    drop {
        println("node freed")
    }
}

func add_child(parent: rc SceneNode, child: rc SceneNode) {
    child.parent = parent.downgrade()
    parent.children.push(child)
}

func world_transform(node: rc SceneNode) -> Mat4 {
    val parent_strong = node.parent.upgrade()
    if parent_strong != null {
        return world_transform(parent_strong).mul(node.transform)
    }
    return node.transform
}

func main() {
    val root = rc SceneNode(Mat4(3.0))
    val child = rc SceneNode(Mat4(2.0))
    add_child(root, child)
    println("tree built")
    println("{world_transform(child).m00}")
    -- root and child freed when main exits; no cycle so both drop
}
