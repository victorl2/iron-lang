-- section 3.6 policies are non-transitive
-- @req: POL-02, POL-06, POL-10
-- @expected-pass-after: phase-28
-- extends-spec: heap container holding rc field; rc lifetime independent of heap container

object Texture {
    val path: String

    drop {
        println("free texture: {path}")
    }
}

object Container {
    val tex: rc Texture
    val tag: Int

    drop {
        println("drop heap container: {tag}")
    }
}

func main() {
    val tex = rc Texture(path: "sprites.png")
    val c = heap Container(tex: tex, tag: 1)
    defer free c
    println("container tag: {c.tag}, tex: {c.tex.path}")
}
