-- section 8.6 per-frame arena allocation
-- @req: ARENA-01, ARENA-03, ARENA-06
-- engine state lives on the stack and drops at exit; per-frame commands are
-- arena-bumped inside `in frame_arena {}` and bulk-freed by reset()

object Renderer {
    val width: Int

    init() {
        self.width = 1920
        println("renderer init")
    }

    drop {
        println("renderer freed")
    }
}

object AudioSystem {
    val sample_rate: Int

    init() {
        self.sample_rate = 44100
        println("audio init")
    }

    drop {
        println("audio freed")
    }
}

object DrawCmd {
    val id: Int
}

func get_frame_time() -> Float {
    return 0.016
}

func submit_to_gpu(cmds: [DrawCmd]) {
    println("frame submitted: {cmds.len()} commands")
}

func main() {
    val renderer = Renderer()
    val audio = AudioSystem()
    val frame_arena = heap Arena.new(64 * 1024)
    defer free frame_arena

    var frames = 0
    while frames < 2 {
        val dt = get_frame_time()

        in frame_arena {
            val first = heap DrawCmd(frames * 10 + 1)
            val second = heap DrawCmd(frames * 10 + 2)
            val cmds = [DrawCmd(first.id), DrawCmd(second.id)]
            submit_to_gpu(cmds)
        }

        frame_arena.reset()    -- O(1) cleanup of all per-frame allocations
        frames = frames + 1
    }
    println("renderer {renderer.width} audio {audio.sample_rate}")
}
