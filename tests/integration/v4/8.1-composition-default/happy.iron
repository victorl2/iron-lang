-- section 8.1 default policy: per-frame game logic
-- @req: PTR-01, PTR-06, READ-01, READ-04
-- compute_damage + tick_combat; stack-allocated values throughout; no visible heap

object Vec2 {
    val x: Float
    val y: Float

    readonly func distance_sq_to(other: *Vec2) -> Float {
        val dx = self.x - other.x
        val dy = self.y - other.y
        return dx * dx + dy * dy
    }
}

object Player {
    val hp: Int
    val attack: Int
    val attack_range: Float
    val pos: Vec2

    readonly func has_buff() -> Bool {
        return false
    }

    readonly func compute_damage(target: *Enemy) -> Int {
        val base = self.attack
        val defense = target.defense
        var multiplier = 1.0
        if self.has_buff() {
            multiplier = 1.5
        }
        return Int(Float(base - defense) * multiplier)
    }
}

object Enemy {
    var hp: Int
    val defense: Int
    val pos: Vec2

    init(hp: Int, defense: Int, pos: Vec2) {
        self.hp = hp
        self.defense = defense
        self.pos = pos
    }
}

func tick_combat(players: [Player], var enemies: [Enemy]) {
    for i in range(players.len()) {
        val player = players[i]
        for j in range(enemies.len()) {
            val distance_sq = player.pos.distance_sq_to(&enemies[j].pos)
            if distance_sq < player.attack_range * player.attack_range {
                val damage = player.compute_damage(&enemies[j])
                enemies[j].hp -= damage
            }
        }
    }
}

func main() {
    val players = [Player(100, 20, 10.0, Vec2(0.0, 0.0))]
    var enemies = [Enemy(50, 5, Vec2(3.0, 4.0))]
    tick_combat(players, enemies)
    println("enemy hp: {enemies[0].hp}")
    println("tick complete")
}
