-- section 8.1 extends-spec: compute_damage chained with armor lookup
-- @req: PTR-01, PTR-06, READ-01, READ-04
-- extends-spec: verifies readonly composition; a readonly method calls
-- readonly methods through checked pointers

object Armor {
    val value: Int
}

object Fighter {
    val attack: Int
    val armor: Armor

    readonly func has_buff() -> Bool {
        return false
    }

    readonly func armor_value() -> Int {
        return self.armor.value
    }

    readonly func net_damage_against(defender: *Fighter) -> Int {
        val base = self.attack
        val reduction = defender.armor_value()
        var multiplier = 1.0
        if self.has_buff() {
            multiplier = 1.5
        }
        return Int(Float(base - reduction) * multiplier)
    }
}

func main() {
    val a = Fighter(30, Armor(5))
    val b = Fighter(10, Armor(8))
    val dmg = a.net_damage_against(&b)
    println("damage: {dmg}")
}
