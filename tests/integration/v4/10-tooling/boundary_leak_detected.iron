-- section 10.5: intentional leaks
-- @leaks-by-design: the program leaks on purpose (the `leak` keyword or a forgotten free)
-- @req: POL-04
-- extends-spec: `leak h` marks a heap value as intentionally permanent: no
-- never-freed warning, and the value stays usable. (The debug allocator's
-- leak report, `iron build --debug-build`, lists heap values that were
-- neither freed nor leaked.)

object World {
    val seed: Int
    val size: Int
}

func make_world() -> Int {
    val w = heap World(1, 64)
    leak w
    return w.size
}

func main() {
    println("work {make_world()}")
}
