-- section 4.9 weak rc policy: non-owning reference via weak rc
-- @req: POL-08, POL-09
-- @expected-pass-after: phase-37
-- canonical downgrade + upgrade probe; upgrade observes payload alive
-- while strong is in scope; T? returned by upgrade.
-- XFAIL (phase-37): upgrade()'s successful CAS takes a +1 strong ref, but
-- scope exit does not yet release an `rc T?` binding (needs optional-payload
-- access in LIR to emit the conditional release), so the final drop line
-- never prints. Leak, not a safety hole — see release notes.

object Texture {
    val path: String

    drop {
        println("free: {self.path}")
    }
}

func main() {
    val strong = rc Texture("hero.png")
    val observer = strong.downgrade()
    val maybe = observer.upgrade()
    println("loaded: {strong.path}")
}
