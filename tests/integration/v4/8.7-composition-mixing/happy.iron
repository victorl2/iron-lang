-- section 8.7 mixing all policies
-- @req: POL-01, POL-02, POL-06, POL-08, ARENA-01
-- stack values, an owned list, rc + weak rc, a heap binding, a Box and an arena in one program

object InputState {
    var quit: Bool

    init(quit: Bool) {
        self.quit = quit
    }
}

object Player {
    val hp: Int
}

object Enemy {
    val id: Int
    val player: weak rc Player
}

object ParticleArray {
    var count: Int

    init(count: Int) {
        self.count = count
    }
}

nocopy object ParticleSystem {
    var storage: Box[ParticleArray]

    init() {
        self.storage = Box.new(ParticleArray(0))
    }
}

object LevelData {
    val seed: Int

    drop {
        println("level freed")
    }
}

object DrawCmd {
    val id: Int
}

object Game {
    var enemies: [Enemy]
    var player: rc Player
    var input_state: InputState
    var ticks: Int

    init() {
        self.enemies = []
        self.player = rc Player(100)
        self.input_state = InputState(false)
        self.ticks = 0
    }

    func spawn_enemy(id: Int) {
        self.enemies.push(Enemy(id, self.player.downgrade()))
    }

    func tick(dt: Float) {
        self.ticks = self.ticks + 1
        if self.ticks >= 2 {
            self.input_state.quit = true
        }
    }

    drop {
        println("game freed")
    }
}

func submit_to_gpu(cmds: [DrawCmd]) {
    println("frame submitted: {cmds.len()} commands")
}

func main() {
    var game = Game()
    game.spawn_enemy(1)
    game.spawn_enemy(2)
    val level = heap LevelData(7)
    defer free level
    val particles = ParticleSystem()
    val frame_arena = heap Arena.new(4 * 1024)
    defer free frame_arena

    while not game.input_state.quit {
        game.tick(0.016)

        in frame_arena {
            val cmd = heap DrawCmd(game.ticks)
            submit_to_gpu([DrawCmd(cmd.id)])
        }
        frame_arena.reset()
    }
    val target = game.enemies[0].player.upgrade()
    if target != null {
        println("enemy 1 sees player hp {target.hp}")
    }
    println("level {level.seed} particles {particles.storage.unwrap().count} enemies {game.enemies.len()}")
}
