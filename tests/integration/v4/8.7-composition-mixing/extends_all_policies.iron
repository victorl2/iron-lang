-- section 8.7 extends-spec: all-policies integration probe
-- @req: POL-01, POL-02, POL-06, POL-08, ARENA-01, DROP-01
-- stack + heap + rc + weak + arena lifecycle interleaved; deferred frees run
-- first, then destructors in reverse binding order; the arena bulk-frees without
-- running drops (W0605, acknowledged with allow_drop_skip)

object StackVal {
    val id: Int

    drop {
        println("stack {self.id} freed")
    }
}

object HeapObj {
    val id: Int

    drop {
        println("heap {self.id} freed")
    }
}

object Shared {
    val id: Int

    drop {
        println("shared {self.id} freed")
    }
}

object ArenaObj {
    val id: Int

    drop {
        println("arena {self.id} freed")
    }
}

object Child {
    val id: Int
    val parent: weak rc Shared

    drop {
        println("child {self.id} freed")
    }
}

func main() {
    -- stack allocation: freed at scope exit
    val sv = StackVal(1)

    -- heap allocation: freed via defer
    val ho = heap HeapObj(2)
    defer free ho

    -- rc allocation: freed when the last reference goes out of scope
    val sh = rc Shared(3)

    -- weak rc: child holds a non-owning reference to shared
    val ch = Child(4, sh.downgrade())

    -- arena allocation: bulk-freed at arena.reset(), no drop
    val arena = heap Arena.new(64 * 1024)
    defer free arena

    in arena {
        val ao = heap(allow_drop_skip: true) ArenaObj(5)
        println("arena obj {ao.id} alive")
    }
    arena.reset()

    val parent = ch.parent.upgrade()
    if parent != null {
        println("child {ch.id} sees shared {parent.id}")
    }
    println("all alive")
}
