-- Regression fixture for the pre-LLVM optimization pipeline:
-- P2b scalar copy coalescing, P7 proven local narrowing, and P6 structured
-- natural-loop reconstruction.  Output parity is the semantic oracle.

func choose(flag: Bool) -> Int {
    var value = 0
    if flag {
        value = 10
    } else {
        value = 20
    }
    return value
}

func main() {
    println("{choose(true)}")
    println("{choose(false)}")

    var outer = 0
    var total = 0
    while outer < 3 {
        var inner = 0
        while inner < 2 {
            total = total + outer * 10 + inner
            inner = inner + 1
        }
        outer = outer + 1
    }

    for i in range(4) {
        total = total + i
    }
    println("{total}")
}
