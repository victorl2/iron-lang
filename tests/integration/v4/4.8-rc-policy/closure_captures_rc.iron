-- section 4.8 rc policy: OQ-03 closure captures rc T
-- @req: POL-06, OQ-03
-- @expected-pass-after: phase-37
-- extends-spec: lambda captures rc T by value; closure outlives original
-- binding; refcount stays > 0 across original drop; closure drop releases.

object Counter {
    val tag: Int

    drop {
        println("drop counter: {self.tag}")
    }
}

func main() {
    val original = rc Counter(99)
    val show = func() {
        println("captured: {original.tag}")
    }
    show()
    show()
    println("main done")
}
