-- section 4.8 rc policy: rc field in container
-- @req: POL-06
-- extends-spec: container with rc field; rc lifetime independent of container drop

object Texture {
    val path: String

    drop {
        println("free texture: {path}")
    }
}

object Container {
    val tex: rc Texture
    val id: Int

    drop {
        println("drop container: {id}")
    }
}

func main() {
    val tex = rc Texture(path: "sprite.png")
    val c = Container(tex: tex, id: 1)
    println("container id: {c.id}, tex: {c.tex.path}")
}
