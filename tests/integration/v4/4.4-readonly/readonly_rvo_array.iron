-- section 4.4 positive: readonly method returning [Int; 2] exercises sret RVO codegen
-- @req: READ-08

object Pair {
    val a: Int
    val b: Int

    readonly func make_pair() -> [Int; 2] {
        return [self.a, self.b]
    }
}

func main() {
    val p = Pair(1, 2)
    val pair = p.make_pair()
    println("pair: {pair[0]}, {pair[1]}")
}
