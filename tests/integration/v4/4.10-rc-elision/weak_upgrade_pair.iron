-- section 4.10 rc elision: weak.upgrade soundness trap
-- @req: OPT-01, POL-08
-- A weak `downgrade` + `upgrade` observes the strong refcount between the
-- conceptual retain and release. weak.upgrade is a hard barrier: deleting a
-- retain/release pair across it would change the count the upgrade observes.
-- Correct output proves the upgrade succeeds while the strong is alive.

object Texture {
    val path: String

    drop {
        println("free: {path}")
    }
}

func main() {
    val strong = rc Texture(path: "hero.png")
    val observer = strong.downgrade()
    val maybe = observer.upgrade()
    println("loaded: {strong.path}")
}
