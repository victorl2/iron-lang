-- section 3.2 heap policy + leak opt-out
-- @req: POL-04, POL-05
-- @expected-pass-after: phase-21
-- extends-spec: leak opt-out from destructor; no drop line in output

object World {
    var seed: Int

    drop {
        println("drop: world")
    }
}

func main() {
    val world = heap World(seed: 99)
    leak world
    println("seed: {world.seed}")
    println("done")
}
