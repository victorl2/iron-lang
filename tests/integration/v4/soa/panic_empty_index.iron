-- @expect-panic: index: 0 bound: 0
-- layout: soa lists: empty_index panics as it does for the default layout,
-- naming the Iron line.
object P {
    var x: Int
    var s: String
    init(x: Int) {
        self.x = x
        self.s = "str-{x}-padding-padding-padding"
    }
    func bump(n: Int) { self.x += n }
    readonly func get() -> Int { return self.x }
}
func observe(p: *P) -> Int { return p.x }
func edit(p: *var P) { p.x += 10 }
func idx(n: Int) -> Int { return n }
func main() {
    var ps: [P, layout: soa] = [P(1), P(2), P(3)]
    var es: [P, layout: soa] = []
    println("start {ps.len()} {es.len()}")
    println("{es[idx(0)].x}")
    println("unreachable")
}
