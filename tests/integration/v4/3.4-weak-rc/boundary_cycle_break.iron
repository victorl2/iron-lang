-- section 3.4 weak rc: cycle breaking with weak rc
-- @req: POL-08, POL-09
-- @expected-pass-after: phase-27
-- extends-spec: drop probes verify both A and B freed (without weak, both would leak)

object NodeB {
    val id: Int

    drop {
        println("drop: B-{self.id}")
    }
}

object NodeA {
    val id: Int
    val b_link: rc NodeB
    var back: weak rc NodeA

    drop {
        println("drop: A-{self.id}")
    }
}

func main() {
    val node_a = rc NodeA(1, rc NodeB(2), weak rc null)
    node_a.back = node_a.demote()
    println("cycle set up")
}
