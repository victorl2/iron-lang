-- section 3.4 weak rc: cycle breaking with weak rc
-- @req: POL-08, POL-09
-- @expected-pass-after: phase-38
-- XFAIL (phase-38): `rc T`/`weak rc T` FIELD type annotations not in the v4 surface (E0297) +
-- E0264 (var field without init) + field mutation through a val rc binding (E0234).
-- extends-spec: drop probes verify both A and B freed (without weak, both would leak)

object NodeB {
    val id: Int

    drop {
        println("drop: B-{self.id}")
    }
}

object NodeA {
    val id: Int
    val b_link: rc NodeB
    var back: weak rc NodeA

    drop {
        println("drop: A-{self.id}")
    }
}

func main() {
    val node_a = rc NodeA(1, rc NodeB(2), weak rc null)
    node_a.back = node_a.downgrade()
    println("cycle set up")
}
