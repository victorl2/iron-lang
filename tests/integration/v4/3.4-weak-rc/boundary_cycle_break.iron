-- section 3.4 weak rc: cycle breaking with weak rc
-- @req: POL-08, POL-09
-- drop probes verify both A and B freed (with a strong back link both would leak)

object NodeB {
    val id: Int

    drop {
        println("drop: B-{self.id}")
    }
}

object NodeA {
    val id: Int
    val b_link: rc NodeB
    var back: weak rc NodeA

    init(id: Int, b: rc NodeB) {
        self.id = id
        self.b_link = b
        self.back = weak rc null
    }

    drop {
        println("drop: A-{self.id}")
    }
}

func main() {
    var node_a = rc NodeA(1, rc NodeB(2))
    node_a.back = node_a.downgrade()
    println("cycle set up")
}
