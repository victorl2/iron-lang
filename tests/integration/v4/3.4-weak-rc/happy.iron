-- section 3.4 weak rc: non-owning references
-- @req: POL-08, POL-09
-- @expected-pass-after: phase-27
-- weak.upgrade() lifecycle + null check: upgrade succeeds while strong alive

object Player {
    val name: String

    drop {
        println("drop: {name}")
    }
}

func main() {
    val strong = rc Player(name: "Alice")
    val weak_ref: weak rc Player = strong.demote()
    val maybe = weak_ref.upgrade()
    if maybe != null {
        println("alive: {maybe.name}")
    }
}
