-- section 3.4 weak rc: upgrade returns null after last strong dropped
-- @req: POL-08, POL-09
-- @expected-pass-after: phase-27
-- extends-spec: scope-exit drops strong; subsequent upgrade returns null

object Resource {
    val id: Int

    drop {
        println("drop: resource {self.id}")
    }
}

func main() {
    var weak_ref: weak rc Resource = weak rc null
    {
        val strong = rc Resource(7)
        weak_ref = strong.demote()
        println("strong alive: id={strong.id}")
    }
    -- strong dropped here
    val maybe = weak_ref.upgrade()
    if maybe == null {
        println("upgrade returned null")
    } else {
        println("upgrade returned value")
    }
}
