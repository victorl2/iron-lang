-- section 3.4 weak rc: upgrade succeeds while strong reference alive
-- @req: POL-08, POL-09
-- @expected-pass-after: phase-38
-- XFAIL (phase-38): T? optional-payload lowering missing — null-compare + field access on
-- upgrade() result emit invalid C; same class as 4.9 upgrade_returns_nullable.
-- extends-spec: probe pointer access via auto-deref on upgraded handle while strong alive

object Entity {
    val x: Int
    val y: Int

    drop {
        println("drop: entity ({self.x},{self.y})")
    }
}

func main() {
    val strong = rc Entity(10, 20)
    val weak_ref = strong.downgrade()
    val handle = weak_ref.upgrade()
    if handle != null {
        println("x: {handle.x}, y: {handle.y}")
    }
    println("done")
}
