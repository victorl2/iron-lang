-- section: 4.4-regime-isolation
-- @req: PTR-04
-- @expected-pass-after: phase-25
-- extends-spec: checked pointer regime works independently when no unchecked code is referenced; positive control fixture proving *T operates without any *unchecked T involvement

object Entity {
    val id: Int
    val score: Int
}

func inspect(e: *Entity) {
    println("id={e.id} score={e.score}")
}

func main() {
    val entity = Entity(7, 100)
    -- Explicitly take checked pointer; no implicit conversion ever attempted
    val checked: *Entity = &entity
    inspect(checked)
    -- Auto-deref field access on checked pointer
    println("direct: {checked.id}")
}
