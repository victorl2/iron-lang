-- section: 6-readonly
-- @req: READ-04, READ-06
-- extends-spec: readonly returning Int (primitive) is compatible (§6.4)

object Stats {
    val base_damage: Int
    val level: Int

    readonly func scaled_damage(multiplier: Int) -> Int {
        return self.base_damage * self.level * multiplier
    }
}

func main() {
    val s = Stats(10, 3)
    val dmg = s.scaled_damage(2)
    println("scaled: {dmg}")
}
