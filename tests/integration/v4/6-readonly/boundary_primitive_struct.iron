-- section: 6-readonly
-- @req: READ-04, READ-06
-- extends-spec: readonly returning primitive-only struct (§6.4 compatible types)

object Stat {
    val a: Int
    val b: Int
}

object Unit {
    val base: Int
    val bonus: Int

    readonly func compute_stat() -> Stat {
        val combined = self.base + self.bonus
        val doubled = combined * 2
        return Stat(combined, doubled)
    }
}

func main() {
    val u = Unit(10, 5)
    val s = u.compute_stat()
    println("a={s.a} b={s.b}")
}
