-- section: 6-readonly
-- @req: READ-01, READ-04
-- description: readonly compute_damage canonical example (§6.1)

object Enemy {
    var hp: Int
    val defense: Int

    init(hp: Int, defense: Int) {
        self.hp = hp
        self.defense = defense
    }
}

object Player {
    val hp: Int
    val attack: Int

    readonly func compute_damage(target: *Enemy) -> Int {
        val base = self.attack
        val defense = target.defense
        return base - defense
    }
}

func main() {
    val player = Player(100, 15)
    val enemy = Enemy(50, 5)
    val dmg = player.compute_damage(&enemy)
    println("damage: {dmg}")
}
