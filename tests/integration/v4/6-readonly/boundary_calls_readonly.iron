-- section: 6-readonly
-- @req: READ-01, READ-03
-- extends-spec: readonly may call another readonly (§6.1 allowed operations)
-- (readonly is a method tier; free functions have no receiver to protect)

object Rect {
    val w: Int
    val h: Int

    readonly func area() -> Int {
        return self.w * self.h
    }

    readonly func double_area() -> Int {
        return self.area() * 2
    }
}

func main() {
    val r = Rect(4, 5)
    val result = r.double_area()
    println("double area: {result}")
}
