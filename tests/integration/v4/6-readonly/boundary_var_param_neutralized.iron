-- section: 6-readonly
-- @req: READ-01, READ-02
-- extends-spec: a readonly method may take a *var parameter; it can read
-- through it but not mutate it (§6.3 neutralization)

object Player {
    val hp: Int
    val attack: Int
}

object Observer {
    val id: Int

    readonly func observe_hp(p: *var Player) -> Int {
        return p.hp
    }

    readonly func observe_attack(p: *var Player) -> Int {
        return p.attack
    }
}

func main() {
    var player = Player(75, 12)
    val o = Observer(1)
    val hp = o.observe_hp(&player)
    val atk = o.observe_attack(&player)
    println("hp={hp} attack={atk}")
}
