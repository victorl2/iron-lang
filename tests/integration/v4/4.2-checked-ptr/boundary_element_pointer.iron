-- section: 4.2-checked-ptr
-- @req: PTR-01, PTR-08
-- element pointer &arr[i] into a stack array; interpolating a checked scalar pointer prints the pointee through a generation checked load

func main() {
    val arr: [Int; 5] = [10, 20, 30, 40, 50]
    val ptr: *Int = &arr[2]
    println("element: {ptr}")
}
