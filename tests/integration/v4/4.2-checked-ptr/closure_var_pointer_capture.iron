-- section: 4.2-checked-ptr
-- @req: PTR-04, PTR-06, OQ-02
-- @expected-pass-after: phase-20
-- @expect-panic: dangling stack pointer to frame
-- extends-spec: §13 OQ-02 closure capture of *var T — symmetric with *T capture. Captures 16B Iron_FatPtr by value; closure body can read AND write through captured pointer; stale-deref panics identically through iron_check_stack_pointer_gen -> iron_panic_stale_stack_pointer. Verifies *var T capture is allowed (per CONTEXT.md OQ-02 lock) and that the panic fires before the write completes.

object Player {
    var hp: Int
    var attack: Int

    init(hp: Int, attack: Int) {
        self.hp = hp
        self.attack = attack
    }
}

func make_healer(p: *var Player) -> func() -> Int {
    return func() -> Int {
        p.hp = p.hp + 10
        return p.hp
    }
}

func build_healer() -> func() -> Int {
    var player = Player(100, 15)
    player.attack = 20
    return make_healer(&player)
}

func main() {
    val healer = build_healer()
    println("hp: {healer()}")
}
