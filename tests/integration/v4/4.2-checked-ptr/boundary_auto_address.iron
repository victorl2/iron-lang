-- section: 4.2-checked-ptr
-- @req: PTR-01, PTR-07
-- @expected-pass-after: phase-20
-- extends-spec: auto-address at call site - passing lvalue T to *T parameter inserts implicit &; soundness: PTR-07 auto-address requires lvalue (cannot address rvalues)

object Player {
    val hp: Int
    val attack: Int
}

func observe(p: *Player) {
    println("hp: {p.hp} attack: {p.attack}")
}

func main() {
    val player = Player(80, 10)
    -- auto-address: compiler inserts implicit & before player
    observe(player)
}
