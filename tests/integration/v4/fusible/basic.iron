// @fusion-loops: 6
// Numeric pipelines cover every built-in stage, direct and named callbacks,
// captured closures, bindings between stages, and a nested pipeline.

//iron:fusible
func inc(x: Int) -> Int {
    return x + 1
}

//iron:fusible
func even(x: Int) -> Bool {
    return x % 2 == 0
}

//iron:fusible
func add(a: Int, b: Int) -> Int {
    return a + b
}

func nested(x: Int) -> Int {
    return [x, x + 1].map(inc).sum()
}

func main() {
    val xs = [1, 2, 3, 4, 5]
    println("{xs.map(inc).filter(even).sum()}")
    println("{xs.filter(func(x: Int) -> Bool { return x > 1 }).map(inc).reduce(10, add)}")

    var side = 0
    xs.map(func(x: Int) -> Int { return x * 3 }).forEach(func(x: Int) { side += x })
    println("{side}")

    val kept = xs.map(inc).filter(func(x: Int) -> Bool { return x < 5 })
    println("{kept.len()} {kept[0]} {kept[2]}")

    val mapped = xs.map(inc)
    val filtered = mapped.filter(even)
    println("{filtered.sum()}")

    val bias = 7
    println("{xs.map(func(x: Int) -> Int { return x + bias }).sum()}")
    println("{xs.map(nested).sum()}")
}
