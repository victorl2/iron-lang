// @expect-panic: integer division by zero
// A callback that can panic keeps its stage whole. The map reaches the zero
// before the filter sees any element, so the panic is the map's, at its
// line, although the filter would have panicked on the first element.

func reciprocal(x: Int) -> Int {
    return 10 / x
}

func later_panic(x: Int) -> Bool {
    return 100 / (x - 5) > 0
}

func main() {
    println("{[2, 0].map(reciprocal).filter(later_panic).sum()}")
}
