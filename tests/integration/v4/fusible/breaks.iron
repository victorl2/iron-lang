// @fusion-loops: 0
// A single stage, a non-fusible operation, and an escaping intermediate do
// not form a chain whose intermediate list can be removed.

//iron:fusible
func twice(x: Int) -> Int {
    return x * 2
}

func main() {
    val xs = [1, 2, 3]
    val one = xs.map(twice)
    println("{one[0]} {one.sum()}")

    val copied = xs.map(twice).copy()
    println("{copied.sum()}")

    val escaped = xs.filter(func(x: Int) -> Bool { return x > 1 })
    println("{escaped.len()}")
    println("{escaped.sum()}")
}
