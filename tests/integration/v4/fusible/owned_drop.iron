// @fusion-loops: 1

object Token {
    val n: Int

    drop {
        println("drop {self.n}")
    }
}

//iron:fusible
func token(x: Int) -> Token {
    return Token(x)
}

//iron:fusible
func number(x: Token) -> Int {
    return x.n
}

func main() {
    val total = [1, 2].map(token).map(number).sum()
    println("sum {total}")
}
