// @fusion-loops: 3

object Calc {
    val bias: Int

    pure func apply(x: Int) -> Int {
        return x + self.bias
    }
}

//iron:fusible
func identity[T](x: T) -> T {
    return x
}

//iron:fusible
func plus_one(x: Int) -> Int {
    return x + 1
}

func main() {
    println("{[2, 3, 4].map(func(x: Int) -> Int { return identity(x) }).sum()}")

    val calc = Calc(5)
    println("{[1, 2].map(func(x: Int) -> Int { return calc.apply(x) }).sum()}")

    val total = Mutex(0)
    for i in range(4) parallel {
        val part = [i, i + 1].map(plus_one).sum()
        val guard = total.lock()
        guard.set(guard.get() + part)
    }
    val guard = total.lock()
    println("{guard.get()}")
}
