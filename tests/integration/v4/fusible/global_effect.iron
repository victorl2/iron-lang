// @fusion-loops: 1
// A global write is observable even when the callback performs no I/O.
var seen = 0

//iron:fusible
func remember(x: Int) -> Int {
    seen = seen * 10 + x
    return x
}

//iron:fusible
func after_all(x: Int) -> Bool {
    return seen >= 123
}

func main() {
    val total = [1, 2, 3].map(remember).filter(after_all).sum()
    println("seen {seen} sum {total}")
}
