// @fusion-loops: 0
// Observable callbacks require stage order, so this pipeline is deliberately
// left unfused: all map calls run before any filter call.

//iron:fusible
func announced(x: Int) -> Int {
    println("map {x}")
    return x * 2
}

//iron:fusible
func accepted(x: Int) -> Bool {
    println("filter {x}")
    return x > 2
}

func main() {
    println("sum {[1, 2, 3].map(announced).filter(accepted).sum()}")
}
