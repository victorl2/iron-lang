-- Hex and base64 against RFC 4648 section 10.
-- Generated by tests/support/crypto_kat_gen.py from RFC 4648.
-- Every expected value is copied from those documents.
import encoding

func h(x: String) -> String {
    val d = Hex.decode(x)
    assert(d.error == 0, "bad hex in fixture")
    return d.data
}


func check(label: String, cond: Bool) -> Int {
    if cond {
        return 1
    }
    println("FAIL {label}")
    return 0
}

func group_rfc_4648_section_10() {
    var ok = 0
    var total = 0
    ok += check("BASE64 empty encode", Base64.encode("") == "")
    total += 1
    ok += check("BASE64 empty decode", Base64.decode("").data == "" and Base64.decode("").error == 0)
    total += 1
    ok += check("base64url empty encode", Base64.url_encode("") == "")
    total += 1
    ok += check("base64url empty decode", Base64.url_decode("").data == "" and Base64.url_decode("").data == "")
    total += 1
    ok += check("BASE64 f encode", Base64.encode("f") == "Zg==")
    total += 1
    ok += check("BASE64 f decode", Base64.decode("Zg==").data == "f" and Base64.decode("Zg==").error == 0)
    total += 1
    ok += check("base64url f encode", Base64.url_encode("f") == "Zg")
    total += 1
    ok += check("base64url f decode", Base64.url_decode("Zg").data == "f" and Base64.url_decode("Zg==").data == "f")
    total += 1
    ok += check("BASE64 fo encode", Base64.encode("fo") == "Zm8=")
    total += 1
    ok += check("BASE64 fo decode", Base64.decode("Zm8=").data == "fo" and Base64.decode("Zm8=").error == 0)
    total += 1
    ok += check("base64url fo encode", Base64.url_encode("fo") == "Zm8")
    total += 1
    ok += check("base64url fo decode", Base64.url_decode("Zm8").data == "fo" and Base64.url_decode("Zm8=").data == "fo")
    total += 1
    ok += check("BASE64 foo encode", Base64.encode("foo") == "Zm9v")
    total += 1
    ok += check("BASE64 foo decode", Base64.decode("Zm9v").data == "foo" and Base64.decode("Zm9v").error == 0)
    total += 1
    ok += check("base64url foo encode", Base64.url_encode("foo") == "Zm9v")
    total += 1
    ok += check("base64url foo decode", Base64.url_decode("Zm9v").data == "foo" and Base64.url_decode("Zm9v").data == "foo")
    total += 1
    ok += check("BASE64 foob encode", Base64.encode("foob") == "Zm9vYg==")
    total += 1
    ok += check("BASE64 foob decode", Base64.decode("Zm9vYg==").data == "foob" and Base64.decode("Zm9vYg==").error == 0)
    total += 1
    ok += check("base64url foob encode", Base64.url_encode("foob") == "Zm9vYg")
    total += 1
    ok += check("base64url foob decode", Base64.url_decode("Zm9vYg").data == "foob" and Base64.url_decode("Zm9vYg==").data == "foob")
    total += 1
    ok += check("BASE64 fooba encode", Base64.encode("fooba") == "Zm9vYmE=")
    total += 1
    ok += check("BASE64 fooba decode", Base64.decode("Zm9vYmE=").data == "fooba" and Base64.decode("Zm9vYmE=").error == 0)
    total += 1
    ok += check("base64url fooba encode", Base64.url_encode("fooba") == "Zm9vYmE")
    total += 1
    ok += check("base64url fooba decode", Base64.url_decode("Zm9vYmE").data == "fooba" and Base64.url_decode("Zm9vYmE=").data == "fooba")
    total += 1
    ok += check("BASE64 foobar encode", Base64.encode("foobar") == "Zm9vYmFy")
    total += 1
    ok += check("BASE64 foobar decode", Base64.decode("Zm9vYmFy").data == "foobar" and Base64.decode("Zm9vYmFy").error == 0)
    total += 1
    ok += check("base64url foobar encode", Base64.url_encode("foobar") == "Zm9vYmFy")
    total += 1
    ok += check("base64url foobar decode", Base64.url_decode("Zm9vYmFy").data == "foobar" and Base64.url_decode("Zm9vYmFy").data == "foobar")
    total += 1
    ok += check("BASE16 empty encode", Hex.encode("") == "")
    total += 1
    ok += check("BASE16 empty decode", Hex.decode("").data == "" and Hex.decode("").data == "")
    total += 1
    ok += check("BASE16 f encode", Hex.encode("f") == "66")
    total += 1
    ok += check("BASE16 f decode", Hex.decode("66").data == "f" and Hex.decode("66").data == "f")
    total += 1
    ok += check("BASE16 fo encode", Hex.encode("fo") == "666f")
    total += 1
    ok += check("BASE16 fo decode", Hex.decode("666F").data == "fo" and Hex.decode("666f").data == "fo")
    total += 1
    ok += check("BASE16 foo encode", Hex.encode("foo") == "666f6f")
    total += 1
    ok += check("BASE16 foo decode", Hex.decode("666F6F").data == "foo" and Hex.decode("666f6f").data == "foo")
    total += 1
    ok += check("BASE16 foob encode", Hex.encode("foob") == "666f6f62")
    total += 1
    ok += check("BASE16 foob decode", Hex.decode("666F6F62").data == "foob" and Hex.decode("666f6f62").data == "foob")
    total += 1
    ok += check("BASE16 fooba encode", Hex.encode("fooba") == "666f6f6261")
    total += 1
    ok += check("BASE16 fooba decode", Hex.decode("666F6F6261").data == "fooba" and Hex.decode("666f6f6261").data == "fooba")
    total += 1
    ok += check("BASE16 foobar encode", Hex.encode("foobar") == "666f6f626172")
    total += 1
    ok += check("BASE16 foobar decode", Hex.decode("666F6F626172").data == "foobar" and Hex.decode("666f6f626172").data == "foobar")
    total += 1
    println("RFC 4648 section 10: {ok}/{total}")
}

func main() {
    group_rfc_4648_section_10()
}
