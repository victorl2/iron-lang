-- Decoder error reporting, binary round trips and String.byte_slice.
import encoding

func show(r: DecodeResult) -> String {
    if r.error == 0 {
        return "ok {Hex.encode(r.data)}"
    }
    return "{r.error} {r.error_message}"
}

func main() {
    println("hex upper: {show(Hex.decode("DEADbeef"))}")
    println("hex odd: {show(Hex.decode("abc"))}")
    println("hex char: {show(Hex.decode("abzz"))}")
    println("hex space: {show(Hex.decode("de ad"))}")
    println("hex empty: {show(Hex.decode(""))}")

    println("b64 no padding: {show(Base64.decode("Zm9vYg"))}")
    println("b64 bad padding: {show(Base64.decode("Zm9vYg="))}")
    println("b64 extra padding: {show(Base64.decode("Zm9v===="))}")
    println("b64 padding inside: {show(Base64.decode("Zm=9vYg=="))}")
    println("b64 url alphabet: {show(Base64.decode("-_-_"))}")
    println("b64 whitespace: {show(Base64.decode("Zm9v\nYmFy"))}")
    println("b64 length: {show(Base64.decode("Zm9vY"))}")
    println("b64url std alphabet: {show(Base64.url_decode("+/+/"))}")
    println("b64url padded: {show(Base64.url_decode("Zm9vYg=="))} {show(Base64.url_decode("Zm9vYg="))}")
    println("b64 trailing bits: {show(Base64.decode("Zh=="))}")

    -- Every byte value through every codec.
    var all = ""
    for i in range(256) {
        all = all + String.from_byte(i)
    }
    println("all bytes: {all.byte_len()}")
    println("hex round trip: {Hex.decode(Hex.encode(all)).data == all} {Hex.encode(all).byte_len()}")
    println("b64 round trip: {Base64.decode(Base64.encode(all)).data == all} {Base64.encode(all).byte_len()}")
    println("b64url round trip: {Base64.url_decode(Base64.url_encode(all)).data == all} {Base64.url_encode(all).byte_len()}")
    println("b64 vs url: {Base64.url_encode(all).contains("+")} {Base64.url_encode(all).contains("=")} {Base64.encode(all).contains("+")}")
    for n in range(7) {
        val s = all.byte_slice(250, 250 + n)
        print("{Base64.encode(s)}|{Base64.url_encode(s)} ")
    }
    println("")

    -- byte_slice counts bytes and clamps like substring.
    val word = "héllo"
    println("byte_slice: [{word.byte_slice(0, 3)}] [{word.byte_slice(1, 3)}] {word.byte_len()} {word.len()}")
    println("byte_slice clamp: [{word.byte_slice(-2, 1)}] [{word.byte_slice(4, 100)}] [{word.byte_slice(5, 2)}] [{word.byte_slice(9, 12)}]")
    val z = String.from_byte(0)
    val bin = "a" + z + "b" + z
    println("zero bytes: {bin.byte_len()} {Hex.encode(bin.byte_slice(1, 4))}")
}
