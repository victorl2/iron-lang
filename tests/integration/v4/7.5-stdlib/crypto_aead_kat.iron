-- Authenticated encryption known-answer tests.
-- Generated by tests/support/crypto_kat_gen.py from RFC 8439 and NIST CAVP gcmEncryptExtIV256 / gcmDecrypt256.
-- Every expected value is copied from those documents.
import crypto
import encoding

func h(x: String) -> String {
    val d = Hex.decode(x)
    assert(d.error == 0, "bad hex in fixture")
    return d.data
}

func kat(label: String, got: String, want: String) -> Int {
    val hex = Hex.encode(got)
    if hex == want {
        return 1
    }
    println("FAIL {label}: got {hex} want {want}")
    return 0
}

func check(label: String, cond: Bool) -> Int {
    if cond {
        return 1
    }
    println("FAIL {label}")
    return 0
}

func group_chacha20_poly1305_rfc_8439() {
    var ok = 0
    var total = 0
    ok += kat("RFC 8439 2.8.2 seal", Crypto.seal(AeadAlgorithm.ChaCha20Poly1305, h("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"), h("070000004041424344454647"), h("4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"), h("50515253c0c1c2c3c4c5c6c7")).data, "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691")
    total += 1
    ok += kat("RFC 8439 2.8.2 open", Crypto.open(AeadAlgorithm.ChaCha20Poly1305, h("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"), h("070000004041424344454647"), h("d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"), h("50515253c0c1c2c3c4c5c6c7")).data, "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e")
    total += 1
    ok += kat("RFC 8439 A.5 open", Crypto.open(AeadAlgorithm.ChaCha20Poly1305, h("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0"), h("000000000102030405060708"), h(""), h("f33388860000000000004e91")).data, "")
    total += 1
    ok += check("RFC 8439 A.5 with a corrupted tag is an authentication error", Crypto.open(AeadAlgorithm.ChaCha20Poly1305, h("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0"), h("000000000102030405060708"), h(""), h("f33388860000000000004e91")).error == 9004)
    total += 1
    println("ChaCha20-Poly1305 RFC 8439: {ok}/{total}")
}

