-- section: 7.5-stdlib
-- @req: UNCHK-IDX-01, VEC-01
-- @expected-pass-after: phase-37
-- Per-site unchecked indexing on a bounded vector [T; <=N]: get_unchecked reads
-- and set_unchecked writes the inline .data storage directly (write goes through
-- the alloca, mirroring the VEC-01 push mutation rule). Bounds are relative to
-- the initialized region .len, not the capacity N. Normal builds carry no guard
-- at these sites; --debug-build keeps it with the "unchecked site" panic.

func main() {
    var bv: [Int; <=6]
    bv.push(11)
    bv.push(22)
    bv.push(33)
    bv.push(44)
    -- in-bounds: 1 < 4 = bv.len() (four pushes above)
    bv.set_unchecked(1, 25)
    -- in-bounds: 0, 1, 3 all < 4 = bv.len()
    println("{bv.get_unchecked(0)}")
    println("{bv.get_unchecked(1)}")
    println("{bv.get_unchecked(3)}")
    println("{bv.len()}")
}
