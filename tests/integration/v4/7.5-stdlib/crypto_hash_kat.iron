    ok += kat("SHA-1 ShortMsg Len=192", Crypto.hash(HashAlgorithm.Sha1, h("46b061ef132b87f6d3b0ee2462f67d910977da20aed13705")), "d7a98289679005eb930ab75efd8f650f991ee952")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=256", Crypto.hash(HashAlgorithm.Sha1, h("0321794b739418c24e7c2e565274791c4be749752ad234ed56cb0a6347430c6b")), "b89962c94d60f6a332fd60f6f07d4f032a586b76")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=320", Crypto.hash(HashAlgorithm.Sha1, h("eb60c28ad8aeda807d69ebc87552024ad8aca68204f1bcd29dc5a81dd228b591e2efb7c4df75ef03")), "c06d3a6a12d9e8db62e8cff40ca23820d61d8aa7")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=384", Crypto.hash(HashAlgorithm.Sha1, h("57e89659d878f360af6de45a9a5e372ef40c384988e82640a3d5e4b76d2ef181780b9a099ac06ef0f8a7f3f764209720")), "f652f3b1549f16710c7402895911e2b86a9b2aee")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=440", Crypto.hash(HashAlgorithm.Sha1, h("ec6b4a88713df27c0f2d02e738b69db43abda3921317259c864c1c386e9a5a3f533dc05f3beeb2bec2aac8e06db4c6cb3cddcf697e03d5")), "a7272e2308622ff7a339460adc61efd0ea8dabdc")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=448", Crypto.hash(HashAlgorithm.Sha1, h("0321736beba578e90abc1a90aa56157d871618f6de0d764cc8c91e06c68ecd3b9de3824064503384db67beb7fe012232dacaef93a000fba7")), "aef843b86916c16f66c84d83a6005d23fd005c9e")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=456", Crypto.hash(HashAlgorithm.Sha1, h("d0a249a97b5f1486721a50d4c4ab3f5d674a0e29925d5bf2678ef6d8d521e456bd84aa755328c83fc890837726a8e7877b570dba39579aabdd")), "be2cd6f380969be59cde2dff5e848a44e7880bd6")
    total += 1
    ok += kat("SHA-1 LongMsg Len=1304", Crypto.hash(HashAlgorithm.Sha1, h("")), "d8fd6a91ef3b6ced05b98358a99107c1fac8c807")
    total += 1
    if true {
        val m = h("")
        var hs = Hasher.new(HashAlgorithm.Sha1)
        var at = 0
        var step = 1
        while at < m.byte_len() {
            hs.update(m.byte_slice(at, at + step))
            at += step
            step = step * 3 + 1
        }
        ok += kat("SHA-1 LongMsg Len=1304 streamed", hs.finish(), "d8fd6a91ef3b6ced05b98358a99107c1fac8c807")
        total += 1
    }
    ok += kat("SHA-1 LongMsg Len=2096", Crypto.hash(HashAlgorithm.Sha1, h("")), "4a75a406f4de5f9e1132069d66717fc424376388")
    total += 1
    if true {
