        var hs = Hasher.new(HashAlgorithm.Sha1)
        var at = 0
        var step = 1
        while at < m.byte_len() {
            hs.update(m.byte_slice(at, at + step))
            at += step
            step = step * 3 + 1
        }
        ok += kat("SHA-1 LongMsg Len=2096 streamed", hs.finish(), "4a75a406f4de5f9e1132069d66717fc424376388")
        total += 1
    }
    println("SHA-1 NIST CAVP: {ok}/{total}")
}

