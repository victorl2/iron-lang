-- Hash known-answer tests: NIST CAVP SHA-1, SHA-2, SHA-3; RFC 1321 MD5.
-- Generated by tests/support/crypto_kat_gen.py from NIST CAVP SHS/SHA-3 byte vectors and RFC 1321.
-- Every expected value is copied from those documents.
import crypto
import encoding

func h(x: String) -> String {
    val d = Hex.decode(x)
    assert(d.error == 0, "bad hex in fixture")
    return d.data
}

func kat(label: String, got: String, want: String) -> Int {
    val hex = Hex.encode(got)
    if hex == want {
        return 1
    }
    println("FAIL {label}: got {hex} want {want}")
    return 0
}

func check(label: String, cond: Bool) -> Int {
    if cond {
        return 1
    }
    println("FAIL {label}")
    return 0
}

func group_sha_1_nist_cavp() {
    var ok = 0
    var total = 0
    ok += kat("SHA-1 ShortMsg Len=0", Crypto.hash(HashAlgorithm.Sha1, ""), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=8", Crypto.hash(HashAlgorithm.Sha1, h("36")), "c1dfd96eea8cc2b62785275bca38ac261256e278")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=24", Crypto.hash(HashAlgorithm.Sha1, h("df4bd2")), "bf36ed5d74727dfd5d7854ec6b1d49468d8ee8aa")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=64", Crypto.hash(HashAlgorithm.Sha1, h("7e3d7b3eada98866")), "24a2c34b976305277ce58c2f42d5092031572520")
    total += 1
    ok += kat("SHA-1 ShortMsg Len=128", Crypto.hash(HashAlgorithm.Sha1, h("3552694cdf663fd94b224747ac406aaf")), "a150de927454202d94e656de4c7c0ca691de955d")
