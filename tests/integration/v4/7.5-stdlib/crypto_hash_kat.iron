func group_shortcuts_and_streaming() {
    var ok = 0
    var total = 0
    ok += check("Crypto.sha1 matches Crypto.hash", Crypto.sha1("iron") == Crypto.hash(HashAlgorithm.Sha1, "iron") and Crypto.sha1("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha1))
    total += 1
    ok += check("Crypto.sha224 matches Crypto.hash", Crypto.sha224("iron") == Crypto.hash(HashAlgorithm.Sha224, "iron") and Crypto.sha224("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha224))
    total += 1
    ok += check("Crypto.sha256 matches Crypto.hash", Crypto.sha256("iron") == Crypto.hash(HashAlgorithm.Sha256, "iron") and Crypto.sha256("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha256))
    total += 1
    ok += check("Crypto.sha384 matches Crypto.hash", Crypto.sha384("iron") == Crypto.hash(HashAlgorithm.Sha384, "iron") and Crypto.sha384("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha384))
    total += 1
    ok += check("Crypto.sha512 matches Crypto.hash", Crypto.sha512("iron") == Crypto.hash(HashAlgorithm.Sha512, "iron") and Crypto.sha512("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha512))
    total += 1
    ok += check("Crypto.sha3_256 matches Crypto.hash", Crypto.sha3_256("iron") == Crypto.hash(HashAlgorithm.Sha3_256, "iron") and Crypto.sha3_256("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha3_256))
    total += 1
    ok += check("Crypto.sha3_512 matches Crypto.hash", Crypto.sha3_512("iron") == Crypto.hash(HashAlgorithm.Sha3_512, "iron") and Crypto.sha3_512("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Sha3_512))
    total += 1
    ok += check("Crypto.md5 matches Crypto.hash", Crypto.md5("iron") == Crypto.hash(HashAlgorithm.Md5, "iron") and Crypto.md5("iron").byte_len() == Crypto.hash_size(HashAlgorithm.Md5))
    total += 1
    var hr = Hasher.new(HashAlgorithm.Sha256)
    hr.update("first message")
    val first = hr.finish()
    hr.update("second")
    ok += check("hasher restarts after finish", hr.finish() == Crypto.sha256("second") and first == Crypto.sha256("first message"))
    total += 1
    var big = Hasher.new(HashAlgorithm.Sha256)
    val thousand = "a".repeat(1000)
    for i in range(1000) {
        big.update(thousand)
    }
    ok += kat("SHA-256 one million a (FIPS 180-2 B.3)", big.finish(), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
    total += 1
    println("shortcuts and streaming: {ok}/{total}")
}

func group_md5_rfc_1321() {
    var ok = 0
    var total = 0
