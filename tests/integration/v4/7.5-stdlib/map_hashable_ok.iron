-- section: 7.5-stdlib
-- @req: STDLIB-03, OQ-01
-- @expected-pass-after: phase-33 (Wave 2 Hashable constraint + primitive-key carve-out)
-- Map[String, Int] is well-formed: String satisfies the Hashable key bound.
-- Positive check-path oracle asserts E0206 is ABSENT.
-- RED until Wave 2 declares Map[K: Hashable, V] + the Hashable interface.

func main() {
    var m: Map[String, Int] = Map.new()
    m.set("one", 1)
    m.set("two", 2)
    println("one: {m.get(\"one\")}")
}
