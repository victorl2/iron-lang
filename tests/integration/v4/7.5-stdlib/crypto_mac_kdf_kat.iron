-- HMAC, HKDF, PBKDF2 and scrypt known-answer tests.
-- Generated by tests/support/crypto_kat_gen.py from RFC 2202, RFC 4231, RFC 5869, RFC 6070 and RFC 7914.
-- Every expected value is copied from those documents.
import crypto
import encoding

func h(x: String) -> String {
    val d = Hex.decode(x)
    assert(d.error == 0, "bad hex in fixture")
    return d.data
}

func kat(label: String, got: String, want: String) -> Int {
    val hex = Hex.encode(got)
    if hex == want {
        return 1
    }
    println("FAIL {label}: got {hex} want {want}")
    return 0
}

func check(label: String, cond: Bool) -> Int {
    if cond {
        return 1
    }
    println("FAIL {label}")
    return 0
}

func group_hmac_md5_and_hmac_sha_1_rfc_2202() {
    var ok = 0
    var total = 0
    ok += kat("RFC 2202 HMAC-MD5 case 1", Crypto.hmac(HashAlgorithm.Md5, h("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), h("4869205468657265")), "9294727a3638bb1c13f48ef8158bfc9d")
    total += 1
    ok += kat("RFC 2202 HMAC-MD5 case 2", Crypto.hmac(HashAlgorithm.Md5, h("4a656665"), h("7768617420646f2079612077616e7420666f72206e6f7468696e673f")), "750c783e6ab0b503eaa86e310a5db738")
