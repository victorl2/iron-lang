func group_streaming_hmac() {
    var ok = 0
    var total = 0
    var mac = Hasher.hmac(HashAlgorithm.Sha256, "Jefe")
    mac.update("what do ya want ")
    mac.update("for nothing?")
    ok += kat("Hasher.hmac RFC 4231 case 2", mac.finish(), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    total += 1
    mac.update("what do ya want for nothing?")
    ok += kat("Hasher.hmac reused after finish", mac.finish(), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    total += 1
    println("streaming HMAC: {ok}/{total}")
}

