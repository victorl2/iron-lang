val PRIVATE_PKCS1 = "-----BEGIN RSA PRIVATE KEY-----\nMIIEogIBAAKCAQEA8NkSvdqt4fnl7uwId5uHgdDEHM1TTw6ZPr36mbbfdh+ehLbb\nv7FCWs/e76bo0VRUGn7UaABPO7HhQc4UJOn0vXBGPUEl7DWPOxWC/CTnsOoh5af3\nGFO6nPpF+39BR/o6H1Zq82WL0NW7WShrNE7mxulzVh1mSHuwZXdmkO6g5fDjGUeM\nshdp1O7RPFOzkOflghacgsJsRwN3AtgLgfF8C6PJMJIWHbHdxmPFQnCz/qhREQU1\nx9eiex03LHym2hJkjvvi9yCytQ8Qlj0XrQIJKBqwwixEf2MyZJbCPUAWoiI1Y03W\nsTUsnBWlEHGfG7BeSAQ9RQMvw50vQS5NEDMiJwIDAQABAoIBABzYUqdMTnD3BfPE\nbwssJGGGyEYOzUB1piLei+nm/gJerRSF9fGSYDkSFkgrfEy9xcjakcPW7aZfmnPQ\nI5d8MaSSksb5S3pru7i+zc42+Uy17dNcd3qBZKMyUjlZt07QiC+CoRJ/gexD/Mkj\nzxsXrAn8oaSZpstdjPXKBA2tlrWTFZUN2jTSc/IIFSn9KIcdpYERSzgY7rZKOXSE\nQCL7h7APRAA4ln4Yf1Aml2PBAmnq2obNm0NWuRxX14a52v2jKvGbv/cCtmPTmXwd\nB3PJApVYxlH07C5ozNaVzfcaiecfZ3CSiS84i1Xx95NIxdM7BgU9cu3ZFak6+ZV1\nBjfs82ECgYEA+ho48mOKSBO2Voqcbb0DMacoLo8Q10dithtGvQDvaRGA5f43q4HT\ntMd3X47PrQWfyRivv0jiPuZiak3pSptKwOQIXzQcZMu5B6BSQjyT2kN65Wb+6xzm\nmt8W78C/jOixiGD6TMk3NcYoW7OKgU/58D0Uk9n9FSx07aHoQvvabDcCgYEA9ob8\nGejmRyYqQKLVKhhyGonbA4wJSqkJGWYw5/xF/Zg5yBwfbJN8ZdXdDODJ456t6RP0\ndjyea8xGj/17l8CuxGvRP+WAhjA+JnRZ78x049U3y0Re8/jQDBO/Z5uiMnS929Ay\naL57MKWts6YlaJ2qD3LmQ1JM/l4f2PonSx3dYZECgYAoDRD3iAc5+aYmf7YDQNSF\nHA6sPg7lWrItFXsjg0XTnpD0w9woY/cCKTstm1IYlCD9dC2YxVQt3HkAKw/j+bBj\n6WCJ1m+BmLo9xWfG4aqPtmS03eSOxCcNwBINPOGv8AeWHmmW6FYmD2ChJsRUZvlQ\nhoeIEc2cmWz0LQxjxa85ywKBgDqm0sO3TVIQGm1WUDC7sCnwMlMdtfg1Txzj2y7W\nLjCvTs/1IOTMEgSIZRbzRBULY4TYYoje0zICX6dSP11TUkEZBaeWCoXiZGbxt5P9\nqLGrwKJzmcOhpp249QjJVkV60NDDL7sL1nM0d6cOGEhTempCg9XwdrDt49XTbhXI\n/SqBAoGAYoNfCv1Js+t10euVPNczQYGNm3no+BjI8cSgCAMW1CaoV2us3mbBQ+ke\neFaSF4h+zkPeSPOOFj1T5a2g2UzJAs/lggdIEWJAfa9mlZn+BcgXBkD95Y46kDRw\nAuT6NXqTA/nzRn9iHd++gaOJncGqofz226qgToXED+P3G89q3uA=\n-----END RSA PRIVATE KEY-----\n"
val PUBLIC_SPKI = "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA8NkSvdqt4fnl7uwId5uH\ngdDEHM1TTw6ZPr36mbbfdh+ehLbbv7FCWs/e76bo0VRUGn7UaABPO7HhQc4UJOn0\nvXBGPUEl7DWPOxWC/CTnsOoh5af3GFO6nPpF+39BR/o6H1Zq82WL0NW7WShrNE7m\nxulzVh1mSHuwZXdmkO6g5fDjGUeMshdp1O7RPFOzkOflghacgsJsRwN3AtgLgfF8\nC6PJMJIWHbHdxmPFQnCz/qhREQU1x9eiex03LHym2hJkjvvi9yCytQ8Qlj0XrQIJ\nKBqwwixEf2MyZJbCPUAWoiI1Y03WsTUsnBWlEHGfG7BeSAQ9RQMvw50vQS5NEDMi\nJwIDAQAB\n-----END PUBLIC KEY-----\n"
val PUBLIC_PKCS1 = "-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEA8NkSvdqt4fnl7uwId5uHgdDEHM1TTw6ZPr36mbbfdh+ehLbbv7FC\nWs/e76bo0VRUGn7UaABPO7HhQc4UJOn0vXBGPUEl7DWPOxWC/CTnsOoh5af3GFO6\nnPpF+39BR/o6H1Zq82WL0NW7WShrNE7mxulzVh1mSHuwZXdmkO6g5fDjGUeMshdp\n1O7RPFOzkOflghacgsJsRwN3AtgLgfF8C6PJMJIWHbHdxmPFQnCz/qhREQU1x9ei\nex03LHym2hJkjvvi9yCytQ8Qlj0XrQIJKBqwwixEf2MyZJbCPUAWoiI1Y03WsTUs\nnBWlEHGfG7BeSAQ9RQMvw50vQS5NEDMiJwIDAQAB\n-----END RSA PUBLIC KEY-----\n"

func message() -> String {
    return "mysql password" + String.from_byte(0) + "scramble"
}

func main() {
    val sha1 = Crypto.rsa_decrypt_oaep(PRIVATE_PKCS8, HashAlgorithm.Sha1, Hex.decode("").data)
    println("decrypt python SHA-1: {sha1.error} {sha1.data == message()}")
    val sha256 = Crypto.rsa_decrypt_oaep(PRIVATE_PKCS1, HashAlgorithm.Sha256, Hex.decode("").data)
    println("decrypt python SHA-256: {sha256.error} {sha256.data == message()}")

    val e1 = Crypto.rsa_encrypt_oaep(PUBLIC_SPKI, HashAlgorithm.Sha1, message())
    val d1 = Crypto.rsa_decrypt_oaep(PRIVATE_PKCS1, HashAlgorithm.Sha1, e1.data)
    println("round trip SPKI SHA-1: {e1.error} {e1.data.byte_len()} {d1.data == message()}")
    val e2 = Crypto.rsa_encrypt_oaep(PUBLIC_PKCS1, HashAlgorithm.Sha256, message())
    val d2 = Crypto.rsa_decrypt_oaep(PRIVATE_PKCS8, HashAlgorithm.Sha256, e2.data)
    println("round trip PKCS1 SHA-256: {e2.error} {e2.data.byte_len()} {d2.data == message()}")
    val again = Crypto.rsa_encrypt_oaep(PUBLIC_SPKI, HashAlgorithm.Sha1, message())
    println("randomized: {again.data != e1.data}")

    val wrong_hash = Crypto.rsa_decrypt_oaep(PRIVATE_PKCS8, HashAlgorithm.Sha256, e1.data)
    println("wrong hash: {wrong_hash.error} [{wrong_hash.data}]")
    val bad_key = Crypto.rsa_encrypt_oaep("not a key", HashAlgorithm.Sha1, message())
    println("bad public key: {bad_key.error} {bad_key.error_message}")
    val pub_as_private = Crypto.rsa_decrypt_oaep(PUBLIC_SPKI, HashAlgorithm.Sha1, e1.data)
    println("public key used to decrypt: {pub_as_private.error}")
    -- 2048-bit key, SHA-256 OAEP: at most 256 - 2 * 32 - 2 = 190 bytes.
    val fits = Crypto.rsa_encrypt_oaep(PUBLIC_SPKI, HashAlgorithm.Sha256, "x".repeat(190))
    val too_long = Crypto.rsa_encrypt_oaep(PUBLIC_SPKI, HashAlgorithm.Sha256, "x".repeat(191))
    println("length limit: {fits.error} {too_long.error} {too_long.error_message}")
}
