-- Password hashing: PHC strings, verification, rehash detection, and
-- malformed or tampered hash strings, which never verify.
-- @parity-timeout: 120
import crypto
import encoding

func fields(encoded: String) -> Int {
    return encoded.split("$").len()
}

func main() {
    val stored = Crypto.hash_password("correct horse battery staple")
    println("scrypt prefix: {stored.starts_with("$scrypt$ln=15,r=8,p=3$")} fields={fields(stored)}")
    println("verify right: {Crypto.verify_password("correct horse battery staple", stored)}")
    println("verify wrong: {Crypto.verify_password("correct horse battery stapler", stored)}")
    println("verify empty: {Crypto.verify_password("", stored)}")
    val again = Crypto.hash_password("correct horse battery staple")
    println("salted: {again != stored}")
    println("needs rehash: {Crypto.password_needs_rehash(stored)}")

    -- The salt and hash fields are 16 and 32 bytes of unpadded base64.
    val parts = stored.split("$")
    println("salt bytes: {Base64.url_decode(parts[3].replace("+", "-").replace("/", "_")).data.byte_len()}")
    println("hash bytes: {Base64.url_decode(parts[4].replace("+", "-").replace("/", "_")).data.byte_len()}")

    -- Cheaper explicit costs, and a password with a zero byte inside.
    val nul_password = "pass" + String.from_byte(0) + "word"
    val cheap = Crypto.hash_password_scrypt(nul_password, 10, 8, 1)
    println("scrypt costs: {cheap.error} {cheap.data.starts_with("$scrypt$ln=10,r=8,p=1$")} {Crypto.verify_password(nul_password, cheap.data)} {Crypto.verify_password("pass", cheap.data)}")
    println("rehash cheap: {Crypto.password_needs_rehash(cheap.data)}")

    val pbkdf2 = Crypto.hash_password_pbkdf2("hunter2", HashAlgorithm.Sha256, 1000)
    println("pbkdf2: {pbkdf2.error} {pbkdf2.data.starts_with("$pbkdf2-sha256$i=1000$")} {Crypto.verify_password("hunter2", pbkdf2.data)} {Crypto.verify_password("hunter3", pbkdf2.data)}")
    val pbkdf2_512 = Crypto.hash_password_pbkdf2("hunter2", HashAlgorithm.Sha512, 1000)
    println("pbkdf2-sha512: {pbkdf2_512.data.starts_with("$pbkdf2-sha512$i=1000$")} {Crypto.verify_password("hunter2", pbkdf2_512.data)}")
    val pbkdf2_1 = Crypto.hash_password_pbkdf2("hunter2", HashAlgorithm.Sha1, 1000)
    println("pbkdf2-sha1: {pbkdf2_1.data.starts_with("$pbkdf2-sha1$i=1000$")} {Crypto.verify_password("hunter2", pbkdf2_1.data)}")

    -- Bad parameters are errors, not panics.
    println("bad scrypt: {Crypto.hash_password_scrypt("x", 0, 8, 1).error} {Crypto.hash_password_scrypt("x", 31, 8, 1).error} {Crypto.hash_password_scrypt("x", 24, 8, 1).error}")
    println("bad pbkdf2: {Crypto.hash_password_pbkdf2("x", HashAlgorithm.Sha256, 0).error} {Crypto.hash_password_pbkdf2("x", HashAlgorithm.Md5, 1000).error} {Crypto.hash_password_pbkdf2("x", HashAlgorithm.Sha3_256, 1000).error}")

    -- A hash from another implementation: the RFC 7914 scrypt vector
    -- (password "password", salt "NaCl", N=1024, r=8, p=16) in PHC form.
    val salt = Base64.encode("NaCl").replace("=", "")
    val dk = Base64.encode(Hex.decode("fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640").data).replace("=", "")
    val external = "$scrypt$ln=10,r=8,p=16$" + salt + "$" + dk
    println("external scrypt: {Crypto.verify_password("password", external)} {Crypto.verify_password("Password", external)}")

    -- Malformed and tampered strings.
    -- Change a character in the middle of the hash: the last one also
    -- carries two padding bits that decoding ignores.
    val at = stored.len() - 5
    var flip = "A"
    if stored.substring(at, at + 1) == "A" {
        flip = "B"
    }
    val tampered = stored.substring(0, at) + flip + stored.substring(at + 1, stored.len())
    val malformed = [
        "",
        "plaintext",
        "$scrypt$",
        "$scrypt$ln=15,r=8$abc$def",
        "$scrypt$ln=015,r=8,p=3$" + parts[3] + "$" + parts[4],
        "$scrypt$ln=99,r=8,p=3$" + parts[3] + "$" + parts[4],
        "$scrypt$ln=15,r=8,p=3$" + parts[3],
        "$scrypt$ln=15,r=8,p=3$" + parts[3] + "$" + parts[4] + "$",
        "$scrypt$ln=15,r=8,p=3$!!!$" + parts[4],
        "$scrypt$ln=15,r=8,p=3$" + parts[3] + "$" + parts[4].substring(0, 10),
        "$pbkdf2-md5$i=1000$" + parts[3] + "$" + parts[4],
        "$pbkdf2-sha256$i=0$" + parts[3] + "$" + parts[4],
        "$argon2id$v=19$m=65536,t=3,p=4$abc$def",
        tampered,
    ]
    var rejected = 0
    for m in malformed {
        if not Crypto.verify_password("correct horse battery staple", m) {
            rejected += 1
        }
    }
    println("malformed rejected: {rejected}/{malformed.len()}")
}
