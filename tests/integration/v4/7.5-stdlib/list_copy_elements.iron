-- section: 7.5-stdlib
-- @req: STDLIB-02
-- @expected-pass-after: phase-38
-- Copying a List[T] where T has a user copy block must deep-copy each element.
-- XFAIL (phase-38): Wave-4 element-copy monomorphization still missing at v4.0.0-alpha —
-- verified: builds and runs, but element `copy` blocks are not invoked on list copy
-- (output lacks the "copy N" lines).

object Tracked {
    val id: Int
    copy {
        println("copy {self.id}")
    }
}

func main() {
    var src: [Tracked] = []
    src.push(Tracked(1))
    src.push(Tracked(2))
    val dst = src
    println("dst: {dst.len()}")
}
