-- section: 7.5-stdlib
-- @req: STDLIB-02
-- Copying a list with .copy() where T has a user copy block runs the copy
-- block for each element. (A plain `val dst = src` is rejected: lists are
-- never duplicated implicitly.)

object Tracked {
    val id: Int
    copy {
        println("copy {self.id}")
    }
}

func main() {
    var src: [Tracked] = []
    src.push(Tracked(1))
    src.push(Tracked(2))
    val dst = src.copy()
    println("dst: {dst.len()}")
}
