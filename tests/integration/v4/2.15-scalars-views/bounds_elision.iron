func sum(v: View[Int]) -> Int {
    var total = 0
    var i = 0
    while i < v.len() {
        total += v[i]
        i += 1
    }
    return total
}

func blocked(v: View[Int]) -> Int {
    var total = 0
    var i = 0
    while i + 2 <= v.len() {
        total += v[i]
        total += v[i + 1]
        i += 2
    }
    return total
}

func main() {
    val xs = [1, 2, 3, 4]
    println("{sum(xs)} {blocked(xs)}")
}
