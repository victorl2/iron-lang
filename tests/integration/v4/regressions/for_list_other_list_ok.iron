-- A loop body may change another list, and assign to elements of the
-- list it iterates (#734).
func main() {
    var xs = [1, 2, 3]
    var ys: [Int] = []
    var s = 0
    for x in xs {
        ys.push(x)
        s += x
    }
    println("{s} {ys.len()}")
    for y in ys {
        xs[0] = y
    }
    println("{xs[0]} {xs.len()}")
}
