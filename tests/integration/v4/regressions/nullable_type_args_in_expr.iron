-- Nullable types inside bracketed expressions: nested `[[Int?]]` literals and
-- type arguments of a constructor (see also nullable_type_args_ctor_elements).
func main() {
    var grid: [[Int?]] = [[1, null], [null]]
    println("{grid[0].len()} {grid[1].len()}")
    val m = Map[String, [Int?]]()
    println("{m.len()}")
}
