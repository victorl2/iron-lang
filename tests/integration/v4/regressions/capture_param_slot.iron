-- A read-only parameter captured by a spawn or a lambda after its load was
-- coalesced into the parameter's slot (#561). The test also builds it with
-- copy propagation left out (IRON_LIR_SKIP=copyprop), where it failed.
func f0(a0: Bool, k: Int) -> Int {
    match (-4) % 5 {
        -4 -> {
            val h = spawn("t") {
                val v = 13 * ((-5) & 7) != (-8) and a0
                return v
            }
            val f = func() -> Int {
                return k * 2
            }
            val b = await h
            println("{b} {f()}")
        }
        else -> {
            println("else")
        }
    }
    return 0
}

func main() {
    println("{f0(true, 21)}")
}
