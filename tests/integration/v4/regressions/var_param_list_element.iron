-- A list element passed to a var parameter.
object P {
    var hp: Int
    init(hp: Int) {
        self.hp = hp
    }
}

object Hub {
    var p: ?*P
    var q: ?*Int
    init() {
        self.p = null
        self.q = null
    }
}

func clobber() -> Int {
    val y = P(9)
    val z = P(10)
    return y.hp + z.hp
}

func touch(var x: Int) {
    x += 1
    println("{x}")
}
func main() {
    var xs = [1, 2, 3]
    touch(xs[0])
    println("{xs[0]}")
}
