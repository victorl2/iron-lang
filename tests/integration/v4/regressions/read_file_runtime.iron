import io
-- Regression: the builtin read_file(path) works outside comptime.
-- It used to pass check and then call an undeclared C function.
func main() {
    IO.write_file("iron_empty_probe.txt", "")
    val s = read_file("iron_empty_probe.txt")
    println("read {len(s)} bytes")
    IO.delete_file("iron_empty_probe.txt")
}
