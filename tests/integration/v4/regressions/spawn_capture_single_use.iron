-- Regression: a value captured by a spawn body and used nowhere else.
--
-- The inliner marked the captured value single-use and inline-eligible, so
-- its declaration was dropped, but the spawn copies captures into the task
-- environment by name: the optimized build referenced an undeclared `_v1`.
-- Values captured by spawn / parallel-for / closures are never inlined.
func run(base: Int) -> Int {
    val h = spawn("param") {
        return base + 1
    }
    return await h
}

func main() {
    val base = 10
    val h = spawn("local") {
        return base + 1
    }
    val r = await h
    val scale = 3
    val f = func(x: Int) -> Int { return x * scale }
    println("{r} {run(20)} {f(4)}")
}
