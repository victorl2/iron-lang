-- A pub var list field set in init is a direct store (#616): the setter
-- dropped the uninitialized field first and the program crashed.
pub object Bag {
    pub var items: [Int]
    pub init() {
        self.items = []
    }
    pub func add(x: Int) {
        self.items.push(x)
    }
}

func main() {
    var b = Bag()
    b.add(3)
    println("{len(b.items)}")
}
