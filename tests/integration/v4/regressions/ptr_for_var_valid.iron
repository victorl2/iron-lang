-- A pointer to the loop variable is valid during the iteration.
object P {
    var hp: Int
    init(hp: Int) {
        self.hp = hp
    }
}

object Hub {
    var p: ?*P
    var q: ?*Int
    init() {
        self.p = null
        self.q = null
    }
}

func clobber() -> Int {
    val y = P(9)
    val z = P(10)
    return y.hp + z.hp
}

func main() {
    var hub = Hub()
    var xs = [P(1), P(2), P(3)]
    for x in xs {
        if x.hp == 2 {
            hub.p = &x
            val q = hub.p
            if q != null {
                println("{q.hp}")
            }
            val p2 = &x
            println("{p2.hp}")
        }
    }
}
