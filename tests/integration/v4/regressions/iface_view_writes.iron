-- Writes through a type test (#179): inside `if x is T` a mutable interface
-- binding is a view of its T payload, so field writes (nested too) and
-- mutating method calls change the binding itself, including through a
-- nullable interface, a `var` parameter and a boxed (large) implementor.
object Tag {
    var id: Int
    init(id: Int) { self.id = id }
}
interface Shape {
    readonly func area() -> Int
}
object Circle impl Shape {
    var r: Int
    init(r: Int) { self.r = r }
    readonly func area() -> Int { return self.r * 3 }
    func grow(by: Int) { self.r = self.r + by }
}
object Square impl Shape {
    var s: Int
    var tag: Tag
    init(s: Int, tag: Tag) {
        self.s = s
        self.tag = tag
    }
    readonly func area() -> Int { return self.s * self.s }
}
object Poly impl Shape {
    var a: Int
    var b: Int
    var c: Int
    var d: Int
    var e: Int
    var f: Int
    var g: Int
    var h: Int
    var i: Int
    var j: Int
    init(a: Int) {
        self.a = a
        self.b = 0
        self.c = 0
        self.d = 0
        self.e = 0
        self.f = 0
        self.g = 0
        self.h = 0
        self.i = 0
        self.j = 0
    }
    readonly func area() -> Int { return self.a + self.j }
    func bump() { self.j = self.j + 10 }
}
func enlarge(var sh: Shape) -> Int {
    if sh is Circle {
        sh.r = sh.r + 100
    }
    return sh.area()
}
func main() {
    var a: Shape = Circle(2)
    if a is Circle {
        a.r = 10
        a.grow(1)
    }
    println("circle {a.area()}")

    var b: Shape = Square(3, Tag(1))
    if b is Square {
        b.tag.id = 7
        b.s = 4
    }
    if b is Square {
        println("square {b.s} {b.tag.id} {b.area()}")
    }

    var o: Shape? = Circle(1)
    if o is Circle {
        o.r = 5
        o.grow(1)
    }
    if o != null {
        println("optional {o.area()}")
    }

    var c: Shape = Circle(1)
    var q: Shape = Square(1, Tag(2))
    println("param {enlarge(c)} {enlarge(q)} {c.area()}")

    var p: Shape = Poly(1)
    if p is Poly {
        p.a = 5
        p.bump()
    }
    println("boxed {p.area()}")

    match a {
        Circle(k) -> { println("match {k.r}") }
        Square(k) -> { println("match {k.s}") }
        Poly(k) -> { println("match {k.a}") }
    }
}
