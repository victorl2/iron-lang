-- @expect-panic: dangling stack pointer to frame
-- A drop block reading a pointer to a local destroyed before its value
-- (see ptr_drop_reads_later_local): list_later form.
object Cnt {
    var n: Int
    var name: String
    init(n: Int) {
        self.n = n
        self.name = "counter number one with a long name"
    }
}
object Guard {
    var c: ?*Cnt
    init() {
        self.c = null
    }
    drop {
        val q = self.c
        if q != null {
            println("sees {q.name}")
        }
    }
}
func main() {
    var gs: [Guard] = []
    gs.push(Guard())
    var c = Cnt(4)
    gs[0].c = &c
    println("end")
}
