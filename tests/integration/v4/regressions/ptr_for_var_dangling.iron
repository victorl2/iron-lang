-- @expect-panic: dangling stack pointer to frame
-- The variable of a for loop is a local of the iteration: a pointer to it
-- kept past the iteration dangles. It named a slot of the enclosing scope.
object P {
    var hp: Int
    init(hp: Int) {
        self.hp = hp
    }
}

object Hub {
    var p: ?*P
    var q: ?*Int
    init() {
        self.p = null
        self.q = null
    }
}

func clobber() -> Int {
    val y = P(9)
    val z = P(10)
    return y.hp + z.hp
}

func main() {
    var hub = Hub()
    var xs = [P(1), P(2), P(3)]
    for x in xs {
        if x.hp == 2 {
            hub.p = &x
        }
    }
    for i in range(1000) {
        xs.push(P(i))
    }
    val q = hub.p
    if q != null {
        println("{q.hp}")
    }
}
