-- `xs[a..b]` is a new list of the elements in [a, b); `xs[a..]` runs to the
-- end. Elements are copied for the new list (#213).
func long(n: String) -> String {
    return "{n} is a long name that will not fit inline anywhere"
}
object P {
    val name: String
    drop { println("drop {self.name}") }
}
func main() {
    val ys = [1, 2, 3, 4]
    val s = ys[1..3]
    println("{s.len()} {s[0]} {s[1]}")
    var zs: [String] = []
    zs.push(long("a"))
    zs.push(long("b"))
    zs.push(long("c"))
    val t = zs[1..]
    println("{t.len()} {t[0]}")
    val u = zs[0..2]
    println("{u.len()} {u[1]}")
    val ps = [P(long("p0")), P(long("p1")), P(long("p2"))]
    val q = ps[0..1]
    println("{q.len()} {q[0].name}")
    val fixed: [Int; 3] = [7, 8, 9]
    val w = fixed[1..3]
    println("{w.len()} {w[1]}")
    println("end")
}
