-- A generic object with a pub field and pub methods in one file (#592).
pub object Bag[T] {
    pub var items: [T]
    pub init() {
        self.items = []
    }
    pub func add(x: T) {
        self.items.push(x)
    }
    pub readonly func size() -> Int {
        return len(self.items)
    }
}

func main() {
    var b = Bag[Int]()
    b.add(3)
    b.add(4)
    var s = Bag[String]()
    s.add("x")
    println("{b.size()} {s.size()}")
}
