-- Regression: list methods.
--
-- The checker typed any unknown method on a list as the list itself, so
-- `xs.bogus()` passed, and the advertised sort / reverse / contains /
-- remove / insert / clear (and any / all / find / for_each) emitted calls to
-- undeclared C functions. Unknown names are now error E0220, and remove,
-- insert, clear, reverse, contains and sort are implemented. contains and
-- sort work on numeric and String elements (contains also on Bool).
-- Bounded vectors [T; <=N] support the same methods (they used to handle
-- only push and len; clear() emitted nothing). Fixed-size arrays [T; N]
-- keep their length: push, pop, insert, remove and clear are errors there
-- (see v4-fail/regressions/fixed_array_push.iron).
object Enemy {
    val hp: Int
}

func main() {
    var xs = [5, 3, 9, 1]
    xs.sort()
    println("sorted: {xs[0]} {xs[1]} {xs[2]} {xs[3]}")
    xs.reverse()
    println("reversed: {xs[0]} {xs[1]} {xs[2]} {xs[3]}")
    println("contains 9: {xs.contains(9)} contains 4: {xs.contains(4)}")
    val removed = xs.remove(1)
    println("removed {removed}, len {xs.len()}: {xs[0]} {xs[1]} {xs[2]}")
    xs.insert(1, 42)
    xs.insert(4, 7)
    println("inserted: {xs[0]} {xs[1]} {xs[2]} {xs[3]} {xs[4]}")
    xs.clear()
    println("cleared len {xs.len()}")

    var names = ["pear", "apple", "fig"]
    names.sort()
    println("{names[0]} {names[1]} {names[2]} {names.contains("fig")}")

    var fs = [2.5, -1.0, 0.5]
    fs.sort()
    println("{fs[0]} {fs[1]} {fs[2]}")

    var enemies = [Enemy(3), Enemy(8)]
    val first = enemies.remove(0)
    enemies.insert(0, Enemy(1))
    println("enemies {first.hp} {enemies[0].hp} {enemies[1].hp} {enemies.len()}")

    var bv: [Int; <=5]
    bv.push(4)
    bv.push(2)
    bv.push(8)
    bv.sort()
    bv.insert(1, 3)
    val last = bv.pop()
    val first_bv = bv.remove(0)
    println("bounded: {first_bv} {last} len {bv.len()} [{bv[0]} {bv[1]}] has3 {bv.contains(3)}")
    bv.reverse()
    println("bounded reversed: {bv[0]} {bv[1]}")
    bv.clear()
    println("bounded cleared len {bv.len()}")
}
