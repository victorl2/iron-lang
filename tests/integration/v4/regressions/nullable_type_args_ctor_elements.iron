-- A constructed container whose type arguments hold a nullable type, as a
-- list element, is an expression: the parser used to read the whole element
-- as a type because of the `?`. Lists of maps and channels compile since #307.
func main() {
    val ms = [Map[String, Int?]()]
    println("{ms.len()}")
    val cs = [Channel[Int?](2), Channel[Int?](3)]
    println("{cs.len()}")
}
