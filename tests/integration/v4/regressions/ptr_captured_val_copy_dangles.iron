-- @expect-panic: dangling stack pointer to frame
-- A val is captured by value: a pointer to it taken inside the lambda refers
-- to the lambda's own copy and ends when the lambda returns.
object P {
    var hp: Int
    init(hp: Int) {
        self.hp = hp
    }
}

object Hub {
    var p: ?*P
    var q: ?*Int
    init() {
        self.p = null
        self.q = null
    }
}

func clobber() -> Int {
    val y = P(9)
    val z = P(10)
    return y.hp + z.hp
}

object FB {
    val f: func()
}
func mk(h: *var Hub) -> FB {
    val x = P(5)
    val f = func() {
        h.p = &x
    }
    return FB(f)
}
func main() {
    var hub = Hub()
    val b = mk(&hub)
    b.f()
    println("{clobber()}")
    val q = hub.p
    if q != null {
        println("{q.hp}")
    }
}
