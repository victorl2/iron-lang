-- section 8.2 heap subsystem with defer free
-- @req: POL-02, POL-04, PTR-01
-- heap World because the value is large; explicit free via defer

object TerrainGrid {
    val seed: Int
}

object Entity {
    val id: Int
}

object PhysicsState {
    val gravity: Float
}

object SpatialHash {
    val cell_size: Float
}

object World {
    var terrain: TerrainGrid
    var entities: [Entity]
    var physics: PhysicsState
    var spatial_index: SpatialHash
    var should_quit: Bool

    init(seed: Int) {
        self.terrain = TerrainGrid(seed)
        self.entities = []
        self.physics = PhysicsState(9.8)
        self.spatial_index = SpatialHash(16.0)
        self.should_quit = false
    }

    drop {
        println("world freed")
    }
}

func game_loop(world: *var World) {
    world.should_quit = true
}

func main() {
    var world = heap World(42)
    defer free world

    game_loop(&world)
    println("quit: {world.should_quit}")
}
