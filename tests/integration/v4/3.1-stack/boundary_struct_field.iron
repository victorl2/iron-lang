-- section 3.1 default stack policy
-- @req: POL-01, DROP-01, DROP-03
-- @expected-pass-after: phase-38
-- XFAIL (phase-38): DROP-03 field-drop chaining not implemented — a drop-less container's
-- fields' drops do not run at container scope exit (verified: builds+runs, "drop: first/second" missing).
-- extends-spec: container drop fires field drops in declaration order

object Probe {
    val name: String

    drop {
        println("drop: {self.name}")
    }
}

object Container {
    val first: Probe
    val second: Probe
}

func main() {
    val c = Container(Probe("first"), Probe("second"))
    println("alive")
}
