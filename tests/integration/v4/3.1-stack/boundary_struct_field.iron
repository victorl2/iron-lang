-- section 3.1 default stack policy
-- @req: POL-01, DROP-01, DROP-03
-- container drop fires field drops in reverse declaration order (DROP-LAYOUT.md)

object Probe {
    val name: String

    drop {
        println("drop: {self.name}")
    }
}

object Container {
    val first: Probe
    val second: Probe
}

func main() {
    val c = Container(Probe("first"), Probe("second"))
    println("alive")
}
