-- section 3.1 default stack policy
-- @req: POL-01, DROP-01
-- @expected-pass-after: phase-22
-- extends-spec: nested {} block scope-exit invariant

object Probe {
    val name: String

    drop {
        println("drop: {name}")
    }
}

func main() {
    println("before")
    {
        val x = Probe(name: "inner")
        println("inside")
    }
    println("after")
}
