-- section 3.1 default stack policy
-- @req: POL-01, DROP-01, DROP-02
-- @expected-pass-after: phase-22
-- extends-spec: probes destructor ordering invariant DROP-02 across 3 nested values

object Probe {
    val name: String

    drop {
        println("drop: {self.name}")
    }
}

func main() {
    val a = Probe("a")
    val b = Probe("b")
    val c = Probe("c")
    println("alive")
}
