-- section 3.1 default stack policy
-- @req: POL-01, DROP-01
-- @expected-pass-after: phase-22
-- extends-spec: rvalue temporary destructor fires at end of statement before next statement

object Probe {
    val name: String
    val value: Int

    drop {
        println("drop: {name}")
    }
}

func make_probe(n: String) -> Probe {
    return Probe(name: n, value: 42)
}

func main() {
    val v = make_probe("temp").value
    println("got: {v}")
}
