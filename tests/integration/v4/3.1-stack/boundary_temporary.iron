-- section 3.1 default stack policy
-- @req: POL-01, DROP-01
-- the rvalue temporary is dropped once its field has been read, before the next statement

object Probe {
    val name: String
    val value: Int

    drop {
        println("drop: {self.name}")
    }
}

func make_probe(n: String) -> Probe {
    return Probe(n, 42)
}

func main() {
    val v = make_probe("temp").value
    println("got: {v}")
}
