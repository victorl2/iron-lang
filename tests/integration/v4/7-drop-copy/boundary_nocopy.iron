-- section: 7-drop-copy
-- @req: DROP-08
-- @expected-pass-after: phase-24
-- extends-spec: nocopy object can be constructed, used, and dropped at scope exit
-- (local type renamed from FileHandle to ConfigFile when Phase 33 landed the
-- stdlib FileHandle — the old name now collides with the builtin, E0201)

nocopy object ConfigFile {
    val name: String
    drop {
        println("closing: {self.name}")
    }
}

func main() {
    val fh = ConfigFile("config.txt")
    println("done with file")
}
