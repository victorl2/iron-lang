-- section: 7-drop-copy
-- @req: DROP-01
-- @expected-pass-after: phase-24
-- description: drop hook canonical - destructor runs at scope exit (§7.1 verbatim)

object Resource {
    val name: String
    drop {
        println("releasing: {self.name}")
    }
}

func main() {
    val r = Resource("db")
    println("using: {r.name}")
}
