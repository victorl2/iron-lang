-- Regression: owner_sym->decl_node blind cast in the resolver.
-- The resolver cast a method owner's declaration to Iron_ObjectDecl without
-- checking its kind. The original program used `extends`, which has since
-- been removed from the language; the patched methods on two objects still
-- exercise the owner lookup.

object Animal {
    val tag: Int
}

object Dog {
    val breed: Int
}

patch object Dog {
    readonly func describe() -> Int {
        val local = 1
        return local + self.breed
    }
}

patch object Animal {
    readonly func get_kind() -> Int {
        return 7
    }
}

func main() {
    val d = Dog(42)
    println("dog.describe: {d.describe()}")
    val a = Animal(3)
    println("animal.kind: {a.get_kind()}")
}
