-- section: 4.3-unchecked-ptr
-- @req: UNCK-01, UNCK-02
-- @expected-pass-after: phase-25
-- extends-spec: extern function takes *unchecked T parameter - FFI boundary; *unchecked T is the ONLY regime that bridges to C ABI (PTR-05: auto-address does not apply to *unchecked T parameters)

extern func c_strlen(s: *unchecked U8) -> Int

func main() {
    val message: [U8; 14] = "Hello, Iron!\0"
    val raw_ptr: *unchecked U8 = message as *unchecked U8
    val length = c_strlen(raw_ptr)
    println("length: {length}")
}
