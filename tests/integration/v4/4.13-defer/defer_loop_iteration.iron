-- section 4.13 defer: DEFER-01 break/continue exit edges
-- @req: DEFER-01
-- @expected-pass-after: phase-32
-- A `defer` inside a loop body is scoped to that body, so it fires on EVERY
-- iteration's exit edge — including the edges taken by `continue` and `break`.
-- Here iterations 0 and 1 `continue` (defer fires each), iteration 2 `break`s
-- (defer fires once more). Build+run fixture (WILL_FAIL in check-only container).

func main() {
    var i = 0
    while i < 5 {
        defer println("iter-cleanup {i}")
        if i == 2 {
            println("break at {i}")
            break
        }
        println("continue at {i}")
        i = i + 1
        continue
    }
    println("done")
}
