-- section 4.13 defer: DEFER-01 loop-iteration exit edges
-- @req: DEFER-01
-- @expected-pass-after: phase-32
-- A `defer` inside a loop body is scoped to that body, so it fires on EVERY
-- iteration's exit edge. Three iterations produce three iter-cleanup lines,
-- each after its body line. Build+run fixture.
-- (Replaces defer_break_continue.iron: Iron has no `break`/`continue`
-- keywords — that fixture exercised a surface that does not exist and only
-- "passed" via an inverted WILL_FAIL row.)

func main() {
    var i = 0
    while i < 3 {
        defer println("iter-cleanup")
        println("body {i}")
        i = i + 1
    }
    println("done")
}
