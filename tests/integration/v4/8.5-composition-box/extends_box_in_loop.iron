-- section 8.5 extends-spec: Box.unwrap inside a loop
-- @req: UNCK-01, UNCK-03
-- extends-spec: Box.unwrap inside a loop probes elision benefit; accumulates sum

object Counter {
    var value: Int

    init(value: Int) {
        self.value = value
    }
}

nocopy object CounterBox {
    var data: Box[Counter]

    init(start: Int) {
        self.data = Box.new(Counter(start))
    }

    func accumulate(n: Int) -> Int {
        val p: *var unchecked Counter = self.data.unwrap()
        var sum = 0
        for i in range(n) {
            p.value += 1
            sum += p.value
        }
        return sum
    }
}

func main() {
    var cb = CounterBox(0)
    val result = cb.accumulate(5)
    println("sum: {result}")
}
