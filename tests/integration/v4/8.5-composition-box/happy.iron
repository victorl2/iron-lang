-- section 8.5 Box performance-critical tight loop
-- @req: UNCK-01, UNCK-03
-- Box[ParticleArray] for hot loop; unwrap yields *unchecked for zero-overhead inner loop

object Vec2 {
    var x: Float
    var y: Float

    init(x: Float, y: Float) {
        self.x = x
        self.y = y
    }
}

object Particle {
    var pos: Vec2
    var vel: Vec2
    var lifetime: Float

    init(pos: Vec2, vel: Vec2, lifetime: Float) {
        self.pos = pos
        self.vel = vel
        self.lifetime = lifetime
    }
}

nocopy object ParticleArray {
    var items: [Particle; <=64]
    var count: Int

    init() {
        self.items = []
        self.count = 0
    }
}

nocopy object ParticleSystem {
    var storage: Box[ParticleArray]
    var count: Int

    init() {
        self.storage = Box(ParticleArray())
        self.count = 0
    }

    func add(p: Particle) {
        val particles: *var unchecked ParticleArray = self.storage.unwrap()
        particles.items.push(p)
        self.count += 1
    }

    func step(dt: Float) {
        val particles: *var unchecked ParticleArray = self.storage.unwrap()
        -- tight inner loop, raw pointer access, no per-deref checks
        for i in range(self.count) {
            particles.items[i].pos.x += particles.items[i].vel.x * dt
            particles.items[i].pos.y += particles.items[i].vel.y * dt
            particles.items[i].lifetime -= dt
        }
    }

    readonly func first_x() -> Float {
        val particles: *unchecked ParticleArray = self.storage.unwrap()
        return particles.items[0].pos.x
    }
}

func main() {
    var ps = ParticleSystem()
    ps.add(Particle(Vec2(0.0, 0.0), Vec2(10.0, 0.0), 1.0))
    ps.step(0.5)
    println("x: {ps.first_x()}")
    println("step complete")
}
