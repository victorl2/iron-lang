-- section 7.3 negative: copying a nocopy value
-- @req: DROP-04
-- @expected-pass-after: phase-24
-- nocopy types cannot be implicitly copied; assignment triggers move semantics
nocopy object FileHandle {
    var fd: Int

    init(d: Int) {
        self.fd = d
    }
}
func main() {
    val a = FileHandle.init(3)
    val b = a
}
