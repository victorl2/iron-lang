-- section 6.1 negative: readonly method performs I/O
-- @req: READ-01
-- @expected-pass-after: phase-22
-- readonly methods may not perform I/O operations such as println
object Calc {
    val seed: Int

    readonly func compute() -> Int {
        println("computing")
        return 1
    }
}
func main() {
    val c = Calc(1)
    val r = c.compute()
}
