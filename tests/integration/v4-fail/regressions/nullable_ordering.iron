-- Ordering a nullable value (x < 5 with x: Int?) has no answer when x is
-- null; it used to pass the checker and emit C that did not compile.
func maybe(n: Int) -> Int? {
    if n == 0 {
        return null
    }
    return n
}

func main() {
    val x = maybe(3)
    if x < 5 {
        println("a")
    }
}
