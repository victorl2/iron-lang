-- @expected-error: E0322
-- A binding narrowed by `is` is a read-only view of the payload for now:
-- writes through it are rejected instead of landing on a copy.
interface Shape {
    readonly func area() -> Int
}
object Circle impl Shape {
    var r: Int
    init(r: Int) { self.r = r }
    readonly func area() -> Int { return self.r }
    func grow() { self.r = self.r + 1 }
}
func main() {
    var v: Shape = Circle(2)
    if v is Circle {
        v.r = 5
        v.grow()
    }
    println("{v.area()}")
}
