-- @expected-error: E0322
-- A binding narrowed by `is` to another interface is a copy of the payload
-- viewed as that interface: calling a mutating method through it is
-- rejected instead of changing the copy.
interface Shape {
    readonly func area() -> Int
}
interface Growable {
    func grow()
}
object Circle impl Shape, Growable {
    var r: Int
    init(r: Int) { self.r = r }
    readonly func area() -> Int { return self.r }
    func grow() { self.r = self.r + 1 }
}
func main() {
    var v: Shape = Circle(2)
    if v is Growable {
        v.grow()
    }
    println("{v.area()}")
}
