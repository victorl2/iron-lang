-- @expected-error: E0220
-- A spawn handle has no methods; done() / result() passed the checker and
-- emitted undeclared C calls. Use `await handle`.
func main() {
  val handle = spawn("h") {
    return 5
  }
  if handle.done() {
    val t = handle.result()
    println("t={t}")
  }
  val r = await handle
  println("r={r}")
}
