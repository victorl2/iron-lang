-- The address of a place inside a growable list element can only be a
-- call argument, whatever leads to it (#680): E0330.
object P {
    var x: Int
    init(x: Int) { self.x = x }
}
object W {
    var ps: [P]
    init() { self.ps = [P(1)] }
}
func main() {
    var w = W()
    val wp = &w
    val p = &wp.ps[0].x
    println("{p}")
}
