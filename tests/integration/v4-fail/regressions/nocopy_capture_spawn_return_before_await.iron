-- @expected-error: E0286
nocopy object Res {
    val id: Int
    drop {
        println("drop {self.id}")
    }
}
-- A return before the await can end the block while the task still borrows (#512).
func run(stop: Bool) -> Int {
    val r = Res(1)
    val t = spawn("t") {
        return r.id
    }
    if stop {
        return 0
    }
    return await t
}
func main() {
    println("{run(false)}")
}
