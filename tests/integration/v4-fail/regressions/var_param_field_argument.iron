-- A `var` parameter takes the caller's binding by address. A field or an
-- element passed to one passed the checker and emitted C that did not
-- compile: E0267.
object P {
    var hp: Int
    init(hp: Int) {
        self.hp = hp
    }
}

func touch(var x: Int) {
    x += 1
}

func main() {
    var o = P(5)
    touch(o.hp)
    println("{o.hp}")
}
