-- #682: a list of nocopy elements cannot duplicate one.
nocopy object P { val x: Int }
object H { val p: P
    init() { self.p = P(1) } }
func main() {
    var ps: [P, layout: soa] = []
    ps.push(P(1))
    val h = H()
    val part = ps.filter(func(p: P) -> Bool { return p.x > 0 })
    println("{ps.len()} {h.p.x}")
}
