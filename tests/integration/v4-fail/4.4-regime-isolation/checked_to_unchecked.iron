-- section 4.4 negative: implicit conversion from checked to unchecked pointer
-- @req: PTR-04, UNCK-01
-- @expected-pass-after: phase-25
-- checked and unchecked pointer regimes are isolated; no implicit conversion
func main() {
    val player: Player = Player.new()
    val checked: *Player = &player
    val unchecked: *unchecked Player = checked
}
