-- section 3.7 negative: arena-allocated object with non-trivial destructor warns
-- @req: ARENA-09
-- @expected-pass-after: phase-28
-- A type with a user `drop` block (or a field whose type transitively has one)
-- allocated via heap(in: arena) WITHOUT allow_drop_skip must emit W06xx:
-- the arena bulk-frees memory without running the per-object destructor.
-- allow_drop_skip: true (see arena_allow_drop_skip.iron) suppresses the warning.

object FileHandle {
    val fd: Int

    drop {
        println("closing fd {fd}")
    }
}

func main() {
    val arena = Arena.with_capacity(4096)
    val fh = heap(in: arena) FileHandle(fd: 7)
    println("fd: {fh.fd}")
}
