// Phase 34 LSP-05: triggers the new 820-range readonly-memory diagnostic
// (IRON_ERR_READONLY_MEMORY=820). The diagnostic code is reserved by Task 2
// of Plan 34-01; the emit site lands in a follow-up plan that touches
// src/analyzer/typecheck.c. textDocument/publishDiagnostics MUST surface
// the code as "E0820" via the data-driven snprintf path in
// src/lsp/facade/diagnostics.c.
object Buffer { var size: Int }
readonly func grow(b: Buffer) -> Int {
    val extra = heap Buffer(64)
    defer free extra
    return b.size + extra.size
}
