import time

-- Matrix chain multiplication: dims has n+1 elements for n matrices
-- dims[i] x dims[i+1] is the dimension of matrix i
func matrix_chain(dims: [Int], n: Int) -> Int {
    var dp = fill(n * n, 0)
    var cl = 2
    while cl <= n {
        var i = 0
        while i <= n - cl {
            val j = i + cl - 1
            -- in-bounds: 0 <= i <= n - cl <= n - 2 and j = i + cl - 1 <= n - 1, so i * n + j < n * n = dp.len()
            dp.set_unchecked(i * n + j, 999999999)
            var k = i
            while k < j {
                -- in-bounds: i <= k < j <= n - 1 keeps i * n + k and (k + 1) * n + j below n * n = dp.len();
                -- dims indices i, k + 1, j + 1 are all <= n < n + 1 = dims.len() (caller contract)
                val cost = dp.get_unchecked(i * n + k) + dp.get_unchecked((k + 1) * n + j) + dims.get_unchecked(i) * dims.get_unchecked(k + 1) * dims.get_unchecked(j + 1)
                if cost < dp.get_unchecked(i * n + j) {
                    dp.set_unchecked(i * n + j, cost)
                }
                k = k + 1
            }
            i = i + 1
        }
        cl = cl + 1
    }
    return dp[0 * n + (n - 1)]
}

func main() {
    val d1 = [10, 30, 5, 60]
    println("Test 1: {matrix_chain(d1, 3)} (expected 4500)")
    val d2 = [40, 20, 30, 10, 30]
    println("Test 2: {matrix_chain(d2, 4)} (expected 26000)")
    val d3 = [5, 10, 3, 12, 5, 50, 6, 8, 15, 20, 25]
    println("Test 3: {matrix_chain(d3, 10)} (expected 5199)")

    val iterations = 328947
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = result + matrix_chain(d3, 4 + (it % 7))
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Matrix Chain Multiplication ===")
    println("Matrices: 10")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
