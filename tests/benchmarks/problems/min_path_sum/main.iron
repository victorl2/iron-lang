import time

func min_path_sum(grid: [Int], rows: Int, cols: Int) -> Int {
    var dp = fill(rows * cols, 0)
    dp[0] = grid[0]
    var j = 1
    while j < cols {
        -- in-bounds: 1 <= j < cols <= rows * cols = dp.len() = grid.len() (caller contract, rows >= 1)
        dp.set_unchecked(j, dp.get_unchecked(j - 1) + grid.get_unchecked(j))
        j = j + 1
    }
    var i = 1
    while i < rows {
        val row = i * cols
        val prev_row = (i - 1) * cols
        -- in-bounds: 0 <= prev_row < row = i * cols <= (rows - 1) * cols < rows * cols = dp.len() = grid.len()
        dp.set_unchecked(row, dp.get_unchecked(prev_row) + grid.get_unchecked(row))
        j = 1
        while j < cols {
            -- in-bounds: i < rows, 1 <= j < cols, so prev_row + j < row + j <= (rows - 1) * cols + (cols - 1) < rows * cols
            val up = dp.get_unchecked(prev_row + j)
            val left = dp.get_unchecked(row + (j - 1))
            var mn = up
            if left < mn {
                mn = left
            }
            dp.set_unchecked(row + j, mn + grid.get_unchecked(row + j))
            j = j + 1
        }
        i = i + 1
    }
    -- in-bounds: (rows - 1) * cols + (cols - 1) = rows * cols - 1 < dp.len()
    return dp.get_unchecked((rows - 1) * cols + (cols - 1))
}

func main() {
    val g1 = [1, 3, 1, 1, 5, 1, 4, 2, 1]
    println("Test 1: {min_path_sum(g1, 3, 3)} (expected 7)")

    var bench = fill(400, 0)
    for i in range(20) {
        for j in range(20) {
            bench[i * 20 + j] = (i * 3 + j * 7 + 5) % 10 + 1
        }
    }
    println("Test 2: {min_path_sum(bench, 20, 20)} (expected 131)")

    val iterations = 256849
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = min_path_sum(bench, 20, 20)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Min Path Sum ===")
    println("Grid: 20x20")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
