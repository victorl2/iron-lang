import time

func knapsack(weights: [Int], values: [Int], n: Int, capacity: Int) -> Int {
    val rows = n + 1
    val cols = capacity + 1
    var dp = fill(rows * cols, 0)
    var i = 1
    while i <= n {
        var w = 0
        while w <= capacity {
            -- in-bounds: 1 <= i <= n, 0 <= w <= capacity = cols - 1, so (i - 1) * cols + w < i * cols + w <= n * cols + (cols - 1) < rows * cols = dp.len()
            dp.set_unchecked(i * cols + w, dp.get_unchecked((i - 1) * cols + w))
            -- in-bounds: 0 <= i - 1 < n = weights.len() = values.len() (caller contract)
            if weights.get_unchecked(i - 1) <= w {
                -- in-bounds: guard gives 0 <= w - weights[i-1] <= w <= cols - 1, so (i - 1) * cols + (w - weights[i-1]) < i * cols <= dp.len() - 1
                val val_ = dp.get_unchecked((i - 1) * cols + (w - weights.get_unchecked(i - 1))) + values.get_unchecked(i - 1)
                if val_ > dp.get_unchecked(i * cols + w) {
                    dp.set_unchecked(i * cols + w, val_)
                }
            }
            w = w + 1
        }
        i = i + 1
    }
    -- in-bounds: n * cols + capacity = rows * cols - 1 < dp.len()
    return dp.get_unchecked(n * cols + capacity)
}

func main() {
    val w1 = [2, 3, 4, 5]
    val v1 = [3, 4, 5, 6]
    println("Test 1: {knapsack(w1, v1, 4, 10)} (expected 13)")

    var w2 = fill(20, 0)
    var v2 = fill(20, 0)
    for i in range(20) {
        w2[i] = (i % 5) + 1
        v2[i] = (i * 3 + 2) % 20 + 1
    }
    println("Test 2: {knapsack(w2, v2, 20, 50)} (expected 202)")

    val iterations = 44964
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = knapsack(w2, v2, 20, 50)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: 0/1 Knapsack ===")
    println("Items: 20, Capacity: 50")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
