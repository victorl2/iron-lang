import time

func max_repeated_subarray(a: [Int], na: Int, b: [Int], nb: Int) -> Int {
    val cols = nb + 1
    var dp = fill((na + 1) * cols, 0)
    var best = 0
    var i = 1
    while i <= na {
        var j = 1
        while j <= nb {
            -- in-bounds: 1 <= i <= na = a.len(), 1 <= j <= nb = b.len() (caller contract)
            if a.get_unchecked(i - 1) == b.get_unchecked(j - 1) {
                -- in-bounds (all dp sites): i <= na, j <= nb = cols - 1, so (i - 1) * cols + (j - 1) < i * cols + j <= (na + 1) * cols - 1 < dp.len()
                dp.set_unchecked(i * cols + j, dp.get_unchecked((i - 1) * cols + (j - 1)) + 1)
                if dp.get_unchecked(i * cols + j) > best {
                    best = dp.get_unchecked(i * cols + j)
                }
            } else {
                dp.set_unchecked(i * cols + j, 0)
            }
            j = j + 1
        }
        i = i + 1
    }
    return best
}

func main() {
    val a1 = [1, 2, 3, 2, 1]
    val b1 = [3, 2, 1, 4, 7]
    println("Test 1: {max_repeated_subarray(a1, 5, b1, 5)} (expected 3)")

    var a2 = fill(30, 0)
    var b2 = fill(30, 0)
    for i in range(30) {
        a2[i] = i % 8
        b2[i] = (i + 3) % 8
    }
    println("Test 2: {max_repeated_subarray(a2, 30, b2, 30)} (expected 27)")

    val iterations = 82781
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = max_repeated_subarray(a2, 30, b2, 30)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Max Length Repeated Subarray ===")
    println("Array sizes: 30, 30")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
