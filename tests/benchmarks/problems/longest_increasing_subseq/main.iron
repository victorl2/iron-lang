import time

func lis(arr: [Int], n: Int) -> Int {
    var dp = fill(n, 1)
    var best = 1
    var i = 1
    while i < n {
        -- in-bounds: 1 <= i < n <= arr.len() (caller contract) and n = dp.len()
        val ai = arr.get_unchecked(i)
        var j = 0
        while j < i {
            -- in-bounds: 0 <= j < i < n <= arr.len() and n = dp.len()
            if arr.get_unchecked(j) < ai {
                val v = dp.get_unchecked(j) + 1
                if v > dp.get_unchecked(i) {
                    dp.set_unchecked(i, v)
                }
            }
            j = j + 1
        }
        -- in-bounds: 1 <= i < n = dp.len()
        if dp.get_unchecked(i) > best {
            best = dp.get_unchecked(i)
        }
        i = i + 1
    }
    return best
}

func main() {
    val a1 = [10, 9, 2, 5, 3, 7, 101, 18]
    println("Test 1: {lis(a1, 8)} (expected 4)")

    var bench = fill(50, 0)
    for i in range(50) {
        bench[i] = (i * 17 + 5) % 37
    }
    println("Test 2: {lis(bench, 50)} (expected 6)")

    val iterations = 54466
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = lis(bench, 50)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Longest Increasing Subsequence ===")
    println("Array size: 50")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
