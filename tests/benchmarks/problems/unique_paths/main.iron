import time

func unique_paths(m: Int, n: Int) -> Int {
    var dp = fill(m * n, 0)
    var i = 0
    while i < m {
        var j = 0
        while j < n {
            -- in-bounds (all sites): 0 <= i < m, 0 <= j < n, so i * n + j < m * n = dp.len();
            -- (i - 1) * n + j >= 0 needs i >= 1 (else-branch only, where i != 0);
            -- i * n + (j - 1) >= 0 needs j >= 1 (else-branch only, where j != 0)
            if i == 0 {
                dp.set_unchecked(i * n + j, 1)
            } elif j == 0 {
                dp.set_unchecked(i * n + j, 1)
            } else {
                dp.set_unchecked(i * n + j, dp.get_unchecked((i - 1) * n + j) + dp.get_unchecked(i * n + (j - 1)))
            }
            j = j + 1
        }
        i = i + 1
    }
    return dp[(m - 1) * n + (n - 1)]
}

func main() {
    println("Test 1: {unique_paths(3, 7)} (expected 28)")
    println("Test 2: {unique_paths(15, 15)} (expected 40116600)")

    val iterations = 632911
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = unique_paths(15, 15)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Unique Paths ===")
    println("Grid: 15x15")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
