import time

func insertion_sort(arr: [Int], n: Int) -> Int {
    var i = 1
    while i < n {
        -- in-bounds: 1 <= i < n <= arr.len() (caller contract)
        val key = arr.get_unchecked(i)
        var j = i - 1
        var done = 0
        while j >= 0 {
            if done == 0 {
                -- in-bounds: 0 <= j <= i - 1 and j + 1 <= i < n <= arr.len()
                if arr.get_unchecked(j) > key {
                    arr.set_unchecked(j + 1, arr.get_unchecked(j))
                    j = j - 1
                } else {
                    done = 1
                }
            } else {
                j = -1
            }
        }
        -- in-bounds: loop exit leaves j >= -1 and j < i, so 0 <= j + 1 <= i < n <= arr.len()
        arr.set_unchecked(j + 1, key)
        i = i + 1
    }
    return 0
}

func skip_dup_lo(arr: [Int], lo: Int, hi: Int, lv: Int) -> Int {
    var l = lo
    while l < hi {
        -- in-bounds: lo <= l < hi <= arr.len() - 1 (caller contract: hi is a valid index)
        if arr.get_unchecked(l) == lv {
            l = l + 1
        } else {
            return l
        }
    }
    return l
}

func skip_dup_hi(arr: [Int], lo: Int, hi: Int, hv: Int) -> Int {
    var h = hi
    while h > lo {
        -- in-bounds: lo <= h <= hi <= arr.len() - 1 and lo >= 0 (caller contract: lo and hi are valid indices)
        if arr.get_unchecked(h) == hv {
            h = h - 1
        } else {
            return h
        }
    }
    return h
}

func three_sum_count(orig: [Int], n: Int) -> Int {
    var arr = fill(n, 0)
    for i in range(n) {
        -- in-bounds: range(n) gives 0 <= i < n = arr.len() and n <= orig.len() (caller contract)
        arr.set_unchecked(i, orig.get_unchecked(i))
    }
    val dummy = insertion_sort(arr, n)

    var count = 0
    var i = 0
    while i < n - 2 {
        var do_work = 1
        if i > 0 {
            -- in-bounds: 1 <= i < n - 2, so i and i - 1 are below n = arr.len()
            if arr.get_unchecked(i) == arr.get_unchecked(i - 1) {
                do_work = 0
            }
        }
        if do_work == 1 {
            var lo = i + 1
            var hi = n - 1
            while lo < hi {
                -- in-bounds: 0 <= i < lo < hi <= n - 1 < n = arr.len()
                val s = arr.get_unchecked(i) + arr.get_unchecked(lo) + arr.get_unchecked(hi)
                if s == 0 {
                    count = count + 1
                    val lv = arr.get_unchecked(lo)
                    val hv = arr.get_unchecked(hi)
                    lo = lo + 1
                    hi = hi - 1
                    lo = skip_dup_lo(arr, lo, hi, lv)
                    hi = skip_dup_hi(arr, lo, hi, hv)
                } elif s < 0 {
                    lo = lo + 1
                } else {
                    hi = hi - 1
                }
            }
        }
        i = i + 1
    }
    return count
}

func main() {
    val a1 = [-1, 0, 1, 2, -1, -4]
    println("Test 1: {three_sum_count(a1, 6)} (expected 2)")

    val a2 = [0, 0, 0, 0]
    println("Test 2: {three_sum_count(a2, 4)} (expected 1)")

    val a3 = [-2, 0, 1, 1, 2]
    println("Test 3: {three_sum_count(a3, 5)} (expected 2)")

    var bench = fill(50, 0)
    for i in range(50) {
        bench[i] = i - 25
    }
    val bench_result = three_sum_count(bench, 50)
    println("Test 4: {bench_result}")

    val iterations = 24906
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = three_sum_count(bench, 50)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Three Sum ===")
    println("Iterations: {iterations}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
