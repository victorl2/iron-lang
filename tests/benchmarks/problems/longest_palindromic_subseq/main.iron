import time

func lps(seq: [Int], n: Int) -> Int {
    var dp = fill(n * n, 0)
    for i in range(n) {
        -- in-bounds: i < n, so i * n + i <= (n - 1) * n + (n - 1) = n * n - 1 < dp.len()
        dp.set_unchecked(i * n + i, 1)
    }
    var cl = 2
    while cl <= n {
        var i = 0
        while i <= n - cl {
            val j = i + cl - 1
            -- in-bounds: 0 <= i <= n - cl and j = i + cl - 1 <= n - 1, so i and j < n = seq.len() (caller contract)
            if seq.get_unchecked(i) == seq.get_unchecked(j) {
                -- in-bounds (all dp sites): i + 1 <= n - cl + 1 <= n - 1 (cl >= 2), i <= j - 1 (cl >= 2), i, j < n, so every r * n + c here has r, c in [0, n)
                dp.set_unchecked(i * n + j, dp.get_unchecked((i + 1) * n + (j - 1)) + 2)
            } else {
                val a = dp.get_unchecked((i + 1) * n + j)
                val b = dp.get_unchecked(i * n + (j - 1))
                if a > b {
                    dp.set_unchecked(i * n + j, a)
                } else {
                    dp.set_unchecked(i * n + j, b)
                }
            }
            i = i + 1
        }
        cl = cl + 1
    }
    -- in-bounds: n >= 1 (caller contract), so n - 1 < n * n = dp.len()
    return dp.get_unchecked(0 * n + (n - 1))
}

func main() {
    val s1 = [2, 2, 1, 2, 2, 1, 2]
    println("Test 1: {lps(s1, 7)} (expected 6)")

    var bench = fill(30, 0)
    for i in range(30) {
        bench[i] = (i * 7 + 3) % 5
    }
    println("Test 2: {lps(bench, 30)} (expected 11)")

    val iterations = 79681
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = lps(bench, 30)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Longest Palindromic Subsequence ===")
    println("Sequence length: 30")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
