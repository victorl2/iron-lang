import time

func coin_change(coins: [Int], nc: Int, amount: Int) -> Int {
    var dp = fill(amount + 1, 999999)
    dp[0] = 0
    var c = 0
    while c < nc {
        -- in-bounds: 0 <= c < nc = coins.len() (caller contract)
        var a = coins.get_unchecked(c)
        while a <= amount {
            -- in-bounds: a starts at coins[c] (positive, caller contract) and only grows, so 0 <= a - coins[c] <= a <= amount < amount + 1 = dp.len()
            val val_ = dp.get_unchecked(a - coins.get_unchecked(c)) + 1
            if val_ < dp.get_unchecked(a) {
                dp.set_unchecked(a, val_)
            }
            a = a + 1
        }
        c = c + 1
    }
    if dp[amount] >= 999999 {
        return -1
    }
    return dp[amount]
}

func main() {
    val coins = [1, 5, 10, 25]
    println("Test 1: {coin_change(coins, 4, 30)} (expected 2)")
    println("Test 2: {coin_change(coins, 4, 100)} (expected 4)")
    println("Test 3: {coin_change(coins, 4, 63)} (expected 6)")

    val iterations = 179856
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        result = coin_change(coins, 4, 100)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Coin Change ===")
    println("Amount: 100, Coins: [1,5,10,25]")
    println("Iterations: {iterations}")
    println("Result: {result}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
