import time

func remove_duplicates(arr: [Int], n: Int) -> Int {
    if n == 0 {
        return 0
    }
    var write = 1
    var i = 1
    while i < n {
        -- in-bounds: 1 <= i < n = arr.len() (caller contract), so i and i - 1 are valid
        if arr.get_unchecked(i) != arr.get_unchecked(i - 1) {
            -- in-bounds: write increments at most once per i, so 1 <= write <= i < n = arr.len()
            arr.set_unchecked(write, arr.get_unchecked(i))
            write = write + 1
        }
        i = i + 1
    }
    return write
}

func main() {
    var a1 = [1, 1, 2]
    println("Test 1: {remove_duplicates(a1, 3)} (expected 2)")

    var a2 = [0, 0, 1, 1, 1, 2, 2, 3, 3, 4]
    println("Test 2: {remove_duplicates(a2, 10)} (expected 5)")

    var a3 = [1, 2, 3, 4, 5]
    println("Test 3: {remove_duplicates(a3, 5)} (expected 5)")

    -- Benchmark: sorted array with duplicates, arr[i] = i / 2
    var bench = fill(100, 0)
    for i in range(100) {
        bench[i] = i / 2
    }
    var bench_copy = fill(100, 0)
    for i in range(100) {
        bench_copy[i] = bench[i]
    }
    println("Test 4: {remove_duplicates(bench_copy, 100)} (expected 50)")

    val iterations = 675675
    val start_ns = Time.now_ns()
    var result = 0
    for it in range(iterations) {
        var tmp = fill(100, 0)
        for i in range(100) {
            tmp[i] = bench[i]
        }
        result = remove_duplicates(tmp, 100)
    }
    val elapsed_ns = Time.now_ns() - start_ns
    val elapsed_ms = elapsed_ns / 1000000

    println("")
    println("=== Benchmark: Remove Duplicates Sorted ===")
    println("Iterations: {iterations}")
    println("Total time: {elapsed_ns} ns")
    println("Total time: {elapsed_ms} ms")
}
