.                      => .
d                      => d
d/                     => d
d/sub/../file          => d/file
d/to_sub               => d/sub
d/to_sub/deeper        => d/sub/deeper
d/to_sub/..            => d
d/chain1               => d/sub
d/chain2               => d/sub/deeper
d/chain2/..            => d/sub
d/sub/up_other/target.txt => other/target.txt
d/sub/up_other/../d/file => d/file
d/to_file              => d/file
d/to_file/x            => error ENOTDIR
d/dangling             => error ENOENT
d/loop_a               => error ELOOP
d/abs_link             => other/target.txt
d/to_fsroot            => (outside scratch root)
d//./sub///deeper/.    => d/sub/deeper
nothing                => error ENOENT
d/absent/x             => error ENOENT
d/sub/up_other/../../file => error ENOENT
