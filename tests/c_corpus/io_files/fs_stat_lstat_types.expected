regular    lstat: - size=13  stat: - size=13
empty      lstat: - size=0  stat: - size=0
hardlink   lstat: - size=13  stat: - size=13
sparse     lstat: - size=1048576  stat: - size=1048576
directory  lstat: d  stat: d
fifo       lstat: p  stat: p
socket     lstat: s  stat: s
sl->file   lstat: l size=3  stat: - size=13
sl->dir    lstat: l size=3  stat: d
sl->dead   lstat: l size=7  stat: ENOENT
sl chain   lstat: l size=7  stat: - size=13
