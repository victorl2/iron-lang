import io
import json
import time

-- usage: bench_json <file> <iterations>
func main(args: [String]) {
    val path = args[0]
    val iters = args[1].to_int()
    val text = IO.read_bytes(path, 1000000000).data
    val mb = Float(text.byte_len()) / 1048576.0
    var best_parse = 1000000000000
    var doc = Json.null()
    for i in range(iters) {
        val t0 = Time.now_ns()
        val r = Json.parse(text)
        val dt = Time.now_ns() - t0
        if r.error != 0 {
            println("parse error {r.error_message}")
            return
        }
        if dt < best_parse {
            best_parse = dt
        }
        doc = r.value
    }
    var best_ser = 1000000000000
    var out_len = 0
    for i in range(iters) {
        val t0 = Time.now_ns()
        val s = doc.to_string()
        val dt = Time.now_ns() - t0
        out_len = s.byte_len()
        if dt < best_ser {
            best_ser = dt
        }
    }
    val pms = Float(best_parse) / 1000000.0
    val sms = Float(best_ser) / 1000000.0
    val omb = Float(out_len) / 1048576.0
    println("{IO.basename(path)} parse {pms} ms {mb / (pms / 1000.0)} MB/s | serialize {sms} ms {omb / (sms / 1000.0)} MB/s")
}
