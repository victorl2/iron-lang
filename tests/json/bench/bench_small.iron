-- bench_small.iron <small.json> <count>: many small documents, the shape
-- of an API service: parse to a tree, decode with JsonReader, and encode
-- records with JsonWriter versus building a tree and serializing it.
import io
import json
import time

object User {
    val id: Int
    val name: String
    val email: String
    val active: Bool
    val balance: Float
}

func rate(label: String, n: Int, bytes: Int, ns: Int) {
    val secs = Float(ns) / 1000000000.0
    val per = Float(ns) / Float(n)
    println("{label}: {per} ns/doc, {Float(bytes) / 1048576.0 / secs} MB/s")
}

func main(args: [String]) {
    val text = IO.read_bytes(args[0], 1000000).data
    val n = args[1].to_int()
    val total = text.byte_len() * n

    var t0 = Time.now_ns()
    var sum = 0
    for i in range(n) {
        val r = Json.parse(text)
        sum += r.value.get("id").int_or(0)
    }
    rate("parse tree   ", n, total, Time.now_ns() - t0)

    t0 = Time.now_ns()
    for i in range(n) {
        var r = JsonReader(text)
        if r.begin_object() {
            var k = r.next_key()
            while k != null {
                if k == "id" {
                    sum += r.int_or(0)
                } else {
                    r.skip()
                }
                k = r.next_key()
            }
        }
    }
    rate("JsonReader   ", n, total, Time.now_ns() - t0)

    val u = User(100001, "Alpha Beta", "user1@example.com", true, 1234.5)
    val w = JsonWriter.compact()
    var bytes = 0
    t0 = Time.now_ns()
    for i in range(n) {
        w.begin_object()
        w.field_int("id", u.id + i)
        w.field_string("name", u.name)
        w.field_string("email", u.email)
        w.field_bool("active", u.active)
        w.field_float("balance", u.balance)
        w.end_object()
        bytes += w.finish().byte_len()
    }
    rate("JsonWriter   ", n, bytes, Time.now_ns() - t0)

    t0 = Time.now_ns()
    bytes = 0
    for i in range(n) {
        val o = Json.obj()
        o.set("id", Json.int(u.id + i))
        o.set("name", Json.str(u.name))
        o.set("email", Json.str(u.email))
        o.set("active", Json.bool(u.active))
        o.set("balance", Json.float(u.balance))
        bytes += o.to_string().byte_len()
    }
    rate("tree+to_string", n, bytes, Time.now_ns() - t0)
    println("checksum {sum}")
}
