-- os.iron -- Iron wrapper for the OS stdlib module: the process environment.
-- The command-line arguments are main's parameter: func main(args: [String]).
object OS {}

-- Whether the environment variable is set (an empty value counts as set).
func OS.has_env(name: String) -> Bool {}

-- The variable's value, or `fallback` when it is not set.
func OS.env_or(name: String, fallback: String) -> String {}

-- The variable's value, or null when it is not set.
func OS.env(name: String) -> String? {
    if OS.has_env(name) {
        return OS.env_or(name, "")
    }
    return null
}

-- Catch SIGINT and SIGTERM (on Windows Ctrl+C, Ctrl+Break and closing the
-- console) instead of ending the process, so a service can stop accepting
-- work, drain and exit cleanly. Poll OS.shutdown_signal() afterwards. A
-- second signal ends the process immediately.
func OS.trap_shutdown_signals() {}

-- The first shutdown signal received since the trap was installed (2 for
-- SIGINT, 15 for SIGTERM), or 0.
func OS.shutdown_signal() -> Int {}

-- The process id.
func OS.pid() -> Int {}

-- End the process now with exit status `code` (0..255), after flushing
-- standard output. Pending drops, defers and running tasks are skipped:
-- use it for fatal errors, not for normal shutdown.
func OS.exit(code: Int) {}

-- The number of CPUs this process may run on (its affinity mask on Linux,
-- so container and taskset limits count), at least 1.
func OS.cpu_count() -> Int {}
