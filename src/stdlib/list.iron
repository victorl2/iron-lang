-- list.iron -- Collection methods on arrays
-- These are extension method declarations for the type checker.
-- Actual implementations are provided by the C runtime (iron_collections.c).
-- Phase 49 (Loop Fusion) will optimize chained calls into single-pass loops.

@fusible
func [T].map[U](f: func(T) -> U) -> [U] {}
@fusible
func [T].filter(f: func(T) -> Bool) -> [T] {}
@fusible
func [T].reduce[U](init: U, f: func(U, T) -> U) -> U {}
@fusible
func [T].forEach(f: func(T)) {}
@fusible
func [T].sum() -> T {}

-- `rc [T]` is sugar for `rc __RcList[T]`: a shared, counted list. Every
-- copy of the handle reaches the same list, which is freed with the last
-- handle. The checker rewrites `xs.push(v)`, `xs[i]`, `xs.len()` and
-- `for x in xs` on the handle into accesses of `items`.
object __RcList[T] {
    val items: [T]
}
