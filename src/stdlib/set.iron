-- set.iron -- Set[T: Hashable]: a hash set.
--
-- The table lives in the C runtime: the compiler instantiates one
-- open-addressing table per concrete T (IRON_HSET_DEFINE in
-- src/runtime/iron_runtime.h, emitted by emit_ensure_hash) and resolves
-- every method below by name (typecheck.c check_hash_method). The
-- declaration carries the Hashable bound on T, enforced at every `Set[T]`
-- (E0206).
--
-- Construction: `var s = Set[Int]()` (the type argument is required).
--
-- Methods (receiver form):
--   s.add(item: T) -> Bool           whether the item was new; needs var
--   s.has(item: T) -> Bool
--   s.remove(item: T) -> Bool        whether the item was present; needs var
--   s.len() -> Int
--   s.clear()                        needs var
--   s.values() -> [T]                fresh list of copies, any order
--   s.copy() -> Set[T]               independent table
--   s.take() -> Set[T]               moves the contents out; needs var
--   for x in s { ... }               read-only copy of each item
--
-- Ownership follows lists: the set owns its items and a set binding is
-- never duplicated implicitly (E0328).

object Set[T: Hashable] {
    val inner: Int  -- opaque storage; the C runtime holds the real Iron_Set_<T>
}
