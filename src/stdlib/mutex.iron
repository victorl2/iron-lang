-- mutex.iron -- Mutex[T]: nocopy mutual-exclusion wrapper around a value of type T.
-- Phase 33 STDLIB-07 (Plan 33-05): Iron-side declaration surface for Mutex[T].
--
-- Actual implementations are provided by the C runtime (emit_ensure_mutex synthesis
-- in src/lir/emit_helpers.c). The compiler recognizes Mutex.new / m.lock by name and
-- intercepts them in typecheck.c (by-name compiler-builtin dispatch, mirroring the
-- Box[T] precedent from Plan 33-07 — Ptr.cast/Ptr.offset lineage).
--
-- Mutex[T] is nocopy (Phase 24 substrate): copying a Mutex[T] binding is a compile
-- error (IRON_ERR_COPY_OF_NOCOPY_TYPE = E0286). The OS primitive (iron_mutex_t) is a
-- non-copyable resource — copying it would alias the lock.
--
-- m.lock() returns a scoped MutexGuard[T] (a second nocopy object) whose synthesized
-- drop releases the lock on scope exit (Phase 32 defer/scope-exit drop substrate,
-- DEFER-04). guard.get()/guard.set(v) read/write the guarded value while the lock is
-- held. The OS primitive lives inside emit_ensure_mutex's synthesized struct; the
-- surface field is `val` opaque storage (the runtime constructs the handle directly).
--
-- Standalone `func Mutex.method[T]` form (NOT `patch object`): generic patch targets
-- are v3.0-rejected (E0101), and Mutex[T] is inherently generic. The standalone-form
-- rejection (parser.c E0321) carves out stdlib-prepend lines, so the prepended
-- mutex.iron is exempt. Mirrors box.iron exactly.

nocopy object Mutex[T] {
    val inner: Int  -- opaque storage; emit_ensure_mutex synthesizes Iron_Mutex_<T> internally

    drop {
        -- Synthesized drop block: invokes Iron_Mutex_<T>_destroy generated by
        -- emit_ensure_mutex. Phase 24 drop synthesis fires because Mutex holds an
        -- OS primitive resource that must be destroyed at scope exit.
    }
}

nocopy object MutexGuard[T] {
    val inner: Int  -- opaque storage; back-pointer to the owning Mutex_<T>

    drop {
        -- Synthesized drop block: invokes Iron_Mutex_<T>_unlock generated by
        -- emit_ensure_mutex. The guard releases the lock on scope exit (DEFER-04).
    }
}

-- Mutex.new(value: T) -> Mutex[T]
-- Constructs a Mutex[T] owning `value`, with the OS primitive initialized.
func Mutex.new[T](value: T) -> Mutex[T] {}

-- m.lock() -> MutexGuard[T]   (receiver-form)
-- Acquires the lock and returns a scoped guard whose drop releases it.
func Mutex.lock[T]() -> MutexGuard[T] {}

-- guard.get() -> T   (receiver-form)
-- Reads the guarded value while the lock is held.
func MutexGuard.get[T]() -> T {}

-- guard.set(value: T)   (receiver-form)
-- Writes the guarded value while the lock is held.
func MutexGuard.set[T](value: T) {}
