-- map.iron -- Map[K: Hashable, V]: a hash table from keys to values.
--
-- The table lives in the C runtime: the compiler instantiates one
-- open-addressing table per concrete (K, V) (IRON_HMAP_DEFINE in
-- src/runtime/iron_runtime.h, emitted by emit_ensure_hash) and resolves
-- every method below by name (typecheck.c check_hash_method, hir_to_lir.c
-- `__hash.<method>`). The declaration here carries the Hashable bound on K,
-- enforced at every `Map[K, V]` (E0206), and the single opaque field keeps
-- the object well-formed for the parts of the compiler that walk fields.
--
-- Construction: `var m = Map[String, Int]()` (both type arguments are
-- required; a map is constructed empty).
--
-- Methods (receiver form):
--   m.put(key: K, value: V)          insert or overwrite; needs var
--   m.get(key: K) -> V               panics when the key is absent
--   m.get_or(key: K, default: V) -> V
--   m.has(key: K) -> Bool
--   m.remove(key: K) -> Bool         whether the key was present; needs var
--   m.len() -> Int
--   m.clear()                        needs var
--   m.keys() -> [K]                  fresh list of key copies, any order
--   m.values() -> [V]                fresh list of value copies, any order
--   m.copy() -> Map[K, V]            independent table
--   m.take() -> Map[K, V]            moves the contents out; needs var
--   for (k, v) in m { ... }          read-only copies of each entry
--
-- Ownership follows lists (#174, #193): the table owns its keys and
-- values, get/get_or hand out copies, and a map binding is never
-- duplicated implicitly (E0328).

object Map[K: Hashable, V] {
    val inner: Int  -- opaque storage; the C runtime holds the real Iron_Map_<K>_<V>
}
