-- http.iron -- synchronous HTTP/1.1 client/server models.
--
-- The API deliberately exposes accept/read/respond as separate blocking
-- operations. Iron programs choose their own concurrency policy with
-- spawn/await instead of the HTTP layer creating an invisible scheduler.
-- All timeouts are milliseconds. Transport failures use the existing
-- IRON_ERR_NET_* range (1000..); HTTP parse/policy failures use 5000...

object HttpServer {
    val fd: Int
}

object HttpConnection {
    val fd: Int
}

-- TLS server/connection handles. The context and tls fields are opaque native
-- handles; applications must close them through the matching methods.
object HttpsServer {
    val fd: Int
    val context: Int
}

object HttpsConnection {
    val fd: Int
    val tls: Int
}

-- Explicit same-origin persistent client/pool. The native handle owns all
-- idle HTTP or HTTPS connections until close.
object HttpClient {
    val handle: Int
}

-- A TCP connection accepted by an HTTPS listener whose TLS handshake has not
-- run yet. This resource owns both the socket and a reference to the server's
-- certificate context until handshake or close consumes it.
object HttpsPendingConnection {
    val fd: Int
    val context: Int
}

object HttpServerResult {
    val server: HttpServer
    val error: Int
    val error_message: String
}

object HttpConnectionResult {
    val connection: HttpConnection
    val error: Int
    val error_message: String
}

object HttpsServerResult {
    val server: HttpsServer
    val error: Int
    val error_message: String
}

object HttpsConnectionResult {
    val connection: HttpsConnection
    val error: Int
    val error_message: String
}

object HttpsPendingConnectionResult {
    val connection: HttpsPendingConnection
    val error: Int
    val error_message: String
}

object HttpClientResult {
    val client: HttpClient
    val error: Int
    val error_message: String
}

object HttpRequest {
    val method: String
    val target: String
    val path: String
    val query: String
    val version: String
    -- Raw header lines separated by CRLF, without the request line.
    val headers: String
    val body: String
    -- HTTP persistence policy derived from the request version and Connection
    -- tokens. Servers may keep the socket only after a framed response.
    val keep_alive: Bool
    val error: Int
    val error_message: String
}

object HttpResponse {
    val status: Int
    val reason: String
    -- Raw header lines separated by CRLF, without the status line.
    val headers: String
    val body: String
    val keep_alive: Bool
    val error: Int
    val error_message: String
}

-- Result/model strings are owned by the returned value and freed with it.
-- `release` is kept for source compatibility and does nothing.
func HttpServerResult.release(result: HttpServerResult) {}
func HttpConnectionResult.release(result: HttpConnectionResult) {}
func HttpsServerResult.release(result: HttpsServerResult) {}
func HttpsConnectionResult.release(result: HttpsConnectionResult) {}
func HttpsPendingConnectionResult.release(result: HttpsPendingConnectionResult) {}
func HttpClientResult.release(result: HttpClientResult) {}
func HttpRequest.release(request: HttpRequest) {}
func HttpResponse.release(response: HttpResponse) {}

object Http {}

-- Server lifecycle and connection I/O.
func Http.listen(host: String, port: Int) -> HttpServerResult {}
func HttpServer.accept(server: HttpServer, timeout: Int) -> HttpConnectionResult {}
func HttpServer.port(server: HttpServer) -> Int {}
func HttpServer.close(server: HttpServer) {}
func HttpConnection.read_request(connection: HttpConnection, max_header_bytes: Int, max_body_bytes: Int, timeout: Int) -> HttpRequest {}
func HttpConnection.send_response(connection: HttpConnection, response: HttpResponse, timeout: Int) -> Int {}
func HttpConnection.send_response_keep_alive(connection: HttpConnection, response: HttpResponse, keep_alive: Bool, timeout: Int) -> Int {}
func HttpConnection.close(connection: HttpConnection) {}

-- HTTPS server lifecycle. The certificate file may contain the leaf plus
-- intermediates in PEM order. The private key must match the leaf certificate.
func Http.listen_tls(host: String, port: Int, certificate_file: String, private_key_file: String) -> HttpsServerResult {}
func HttpsServer.accept(server: HttpsServer, timeout: Int) -> HttpsConnectionResult {}
-- Resilient admission model: accept_tcp is bounded only by the listener
-- deadline. Move the returned pending connection into a handler task and give
-- handshake its own shorter deadline. Both handshake and close consume it.
func HttpsServer.accept_tcp(server: HttpsServer, timeout: Int) -> HttpsPendingConnectionResult {}
func HttpsPendingConnection.handshake(connection: HttpsPendingConnection, timeout: Int) -> HttpsConnectionResult {}
func HttpsPendingConnection.close(connection: HttpsPendingConnection) {}
func HttpsServer.port(server: HttpsServer) -> Int {}
func HttpsServer.close(server: HttpsServer) {}
func HttpsConnection.read_request(connection: HttpsConnection, max_header_bytes: Int, max_body_bytes: Int, timeout: Int) -> HttpRequest {}
func HttpsConnection.send_response(connection: HttpsConnection, response: HttpResponse, timeout: Int) -> Int {}
func HttpsConnection.send_response_keep_alive(connection: HttpsConnection, response: HttpResponse, keep_alive: Bool, timeout: Int) -> Int {}
func HttpsConnection.close(connection: HttpsConnection) {}

-- Client requests transparently support http:// and verified https:// URLs.
-- `max_body_bytes` bounds the decoded response body, including chunked
-- responses. HEAD responses never consume the declared representation body.
func Http.request(method: String, url: String, headers: String, body: String, max_body_bytes: Int, timeout: Int) -> HttpResponse {}
func Http.get(url: String, timeout: Int) -> HttpResponse {}
func Http.post_json(url: String, body: String, timeout: Int) -> HttpResponse {}

-- Certificate verification and hostname/IP matching are enabled by default.
-- `get_with_ca` is for private PKI/test roots. The explicitly named insecure
-- variant is development-only and must never be used for production secrets.
func Http.request_with_ca(method: String, url: String, headers: String, body: String, max_body_bytes: Int, ca_file: String, timeout: Int) -> HttpResponse {}
func Http.request_insecure(method: String, url: String, headers: String, body: String, max_body_bytes: Int, timeout: Int) -> HttpResponse {}
func Http.get_with_ca(url: String, ca_file: String, timeout: Int) -> HttpResponse {}
func Http.get_insecure(url: String, timeout: Int) -> HttpResponse {}

-- Open an explicit same-origin connection pool. `origin` supplies scheme,
-- host, and port only (an optional trailing slash is accepted); request
-- targets must be origin-form paths beginning with /. CA and insecure options
-- are rejected for plain HTTP instead of being silently ignored.
-- max_connections bounds concurrent sockets. Idle connections older than
-- idle_timeout milliseconds are closed before reuse. For HTTPS, ca_file=""
-- uses system roots; insecure=true is development-only.
func HttpClient.open(origin: String, ca_file: String, insecure: Bool, max_connections: Int, idle_timeout: Int) -> HttpClientResult {}
func HttpClient.request(client: HttpClient, method: String, target: String, headers: String, body: String, max_body_bytes: Int, timeout: Int) -> HttpResponse {}
func HttpClient.close(client: HttpClient) {}

-- Response constructors for REST endpoints and webpages.
func Http.response(status: Int, headers: String, body: String) -> HttpResponse {}
func Http.json_response(status: Int, body: String) -> HttpResponse {}
func Http.html_response(status: Int, body: String) -> HttpResponse {}
func Http.text_response(status: Int, body: String) -> HttpResponse {}
func Http.file_response(status: Int, path: String, content_type: String, max_body_bytes: Int) -> HttpResponse {}

-- Case-insensitive lookup in the raw `headers` field. Returns "" when absent.
func Http.header(headers: String, name: String) -> String {}

-- ── Readiness-driven serving: HttpPoller ─────────────────────────────────
--
-- A handler task per connection holds a worker for as long as the client
-- keeps the connection open, so a keep-alive server can serve only as many
-- clients as there are workers. An HttpPoller keeps idle connections away
-- from the workers: it accepts from the listener itself and next() returns
-- a connection only once a request has started to arrive on it. A worker
-- reads and answers that one request, then gives the connection back with
-- park() (keep-alive) or discard() (close):
--
--   val poller = Http.poller(server, 30000)
--   while running {
--       val ready = poller.next(1000)
--       if ready.error == 0 {
--           val c = ready.connection
--           spawn("request") { return serve_one(poller, c) }
--       }
--   }
--
-- New connections are TCP_NODELAY and non-blocking. Connections waiting
-- for a first request or parked between requests are closed after
-- idle_timeout milliseconds (0: never). next() returns error 1004 when its
-- timeout passes and 1013 once the poller is closed. close() closes every
-- connection the poller holds and wakes next(); a connection handed out by
-- next() stays its worker's, and parking it after close() closes it. The
-- poller does not own the listener: close the HttpServer separately.
-- Connections taken from next() should be given back with park() or
-- discard() rather than HttpConnection.close.
object HttpPollerCore {
    val handle: Int

    drop {
        HttpPollerNative.free(self.handle)
    }
}

object HttpPoller {
    val core: rc HttpPollerCore
    val error: Int
    val error_message: String
}

-- Native entry points (iron_http.c). Not part of the public API.
object HttpPollerNative {}
func HttpPollerNative.open(listen_fd: Int, idle_timeout: Int) -> Int {}
func HttpPollerNative.next(h: Int, timeout: Int) -> Int {}
func HttpPollerNative.park(h: Int, fd: Int) {}
func HttpPollerNative.discard(h: Int, fd: Int) {}
func HttpPollerNative.close(h: Int) {}
func HttpPollerNative.free(h: Int) {}
func HttpPollerNative.count(h: Int, what: Int) -> Int {}
func HttpPollerNative.error_message(code: Int) -> String {}
func HttpPollerNative.closed(h: Int) -> Bool {}

func Http.poller(server: HttpServer, idle_timeout: Int) -> HttpPoller {
    val h = HttpPollerNative.open(server.fd, idle_timeout)
    if h < 0 {
        return HttpPoller(rc HttpPollerCore(0), 0 - h, HttpPollerNative.error_message(0 - h))
    }
    return HttpPoller(rc HttpPollerCore(h), 0, "")
}

patch object HttpPoller {
    readonly func ok() -> Bool {
        return self.error == 0
    }

    -- The next connection with request bytes waiting, within `timeout`
    -- milliseconds (0 polls once).
    readonly func next(timeout: Int) -> HttpConnectionResult {
        val fd = HttpPollerNative.next(self.core.handle, timeout)
        if fd < 0 {
            return HttpConnectionResult(HttpConnection(-1), 0 - fd, HttpPollerNative.error_message(0 - fd))
        }
        return HttpConnectionResult(HttpConnection(fd), 0, "")
    }

    -- Hand a connection back after a keep-alive response; next() returns it
    -- again when its next request arrives.
    readonly func park(connection: HttpConnection) {
        HttpPollerNative.park(self.core.handle, connection.fd)
    }

    -- Close a connection taken from next(). When the client is still sending
    -- (a request rejected unread), the answer already written is protected
    -- from a connection reset: input is drained for up to a second first.
    readonly func discard(connection: HttpConnection) {
        HttpPollerNative.discard(self.core.handle, connection.fd)
    }

    -- Close every held connection and make next() return 1013.
    readonly func close() {
        HttpPollerNative.close(self.core.handle)
    }

    -- Whether close() has run (a cheap check, for example to answer with
    -- Connection: close while a server drains).
    readonly func closed() -> Bool {
        return HttpPollerNative.closed(self.core.handle)
    }

    -- Connections parked between requests.
    readonly func parked() -> Int {
        return HttpPollerNative.count(self.core.handle, 0)
    }

    -- Accepted connections that have not sent a first request yet.
    readonly func waiting() -> Int {
        return HttpPollerNative.count(self.core.handle, 1)
    }

    -- Connections accepted since the poller opened.
    readonly func accepted() -> Int {
        return HttpPollerNative.count(self.core.handle, 3)
    }

    -- Connections closed for idleness since the poller opened.
    readonly func expired() -> Int {
        return HttpPollerNative.count(self.core.handle, 4)
    }
}
