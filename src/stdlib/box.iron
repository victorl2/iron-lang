-- box.iron -- Box[T]: single-ownership heap allocation with unchecked-pointer escape
-- Phase 25 STDLIB-05: Iron-side declaration surface for Box[T].
-- Actual implementations are provided by the C runtime (emit_ensure_box synthesis
-- in src/lir/emit_helpers.c). The compiler recognizes Box.new / Box.null /
-- Box.unwrap / Box.free / Box.is_null by name and intercepts them in typecheck.c
-- (Phase 25 Plan 25-02 compiler-builtin dispatch, mirroring Ptr.cast/Ptr.offset).
-- Box[T] is nocopy (Phase 24 substrate): copying a Box[T] binding is a compile
-- error (IRON_ERR_COPY_OF_NOCOPY_TYPE = E0286).
-- Box.unwrap() returns *unchecked T (bare C T*, 8B, no generation tracking).
-- Pre-free deref of the returned pointer is UNDEFINED BEHAVIOR (DROP-07 reference;
-- see docs/dev/UNCHECKED-LAYOUT.md §4 for the UB contract).
-- PHASE-26 HOOK: rc Box[T] interaction TBD — rc + nocopy may be forbidden.
--   Phase 26 (rc Policy) decides whether `rc Box[T]` is a compile error.
--   Locations: src/analyzer/typecheck.c regime-mismatch emission site +
--              src/lir/emit_helpers.c emit_ensure_box function.

nocopy object Box[T] {
    var inner: Int  -- opaque storage; emit_ensure_box synthesizes Iron_FatPtr internally

    drop {
        -- Synthesized drop block: invokes Iron_Box_<T>_free generated by emit_ensure_box.
        -- Phase 24 drop synthesis triggers because Box has an internal heap resource.
        -- Explicit Box.free() is faster (no drop-block overhead at scope exit);
        -- implicit drop is safer (resource released even without explicit free call).
    }
}

-- Box.new(value: T) -> Box[T]
-- Allocates value on the heap and returns an owning Box[T].
-- Wraps iron_heap_alloc (Phase 19 substrate) via Iron_Box_<T>_new generated helper.
-- Emit: compiler-builtin dispatch in typecheck.c; Iron_Box_<T>_new in emit_ensure_box.
func Box.new[T](value: T) -> Box[T] {}

-- Box.null() -> Box[T]
-- Constructs a null (empty) Box[T] with no heap allocation.
-- Box.is_null() can be used to test before calling unwrap().
-- Calling unwrap() on a null Box panics deterministically.
func Box.null[T]() -> Box[T] {}

-- Box.unwrap(self: *var Box[T]) -> *unchecked T
-- Returns a bare C T* (8B, no generation tracking, zero runtime check on deref).
-- Box[T] remains alive and will drop at scope exit unless freed via Box.free().
-- DO NOT use the returned *unchecked T after the Box is dropped or freed (UB).
-- Panics if the Box was constructed via Box.null() (null Box).
func Box.unwrap[T](self: *var Box[T]) -> *unchecked T {}

-- Box.free(self: *var Box[T])
-- Explicitly releases the heap allocation. Faster than relying on the implicit
-- drop block. After Box.free(), the *unchecked T previously returned by unwrap()
-- is a dangling pointer — any use is UNDEFINED BEHAVIOR.
func Box.free[T](self: *var Box[T]) {}

-- Box.is_null(self: *var Box[T]) -> Bool
-- Returns true if the Box was constructed via Box.null() (no allocation).
-- Safe to call on any Box[T]; does not dereference the inner pointer.
func Box.is_null[T](self: *var Box[T]) -> Bool {}
