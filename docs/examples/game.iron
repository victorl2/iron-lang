-- game.iron — a minimal raylib game in Iron v4.
--
-- Move the square with the arrow keys and collect the coin. Mirrors the
-- API surface used by examples/pong/pong.iron and
-- tests/manual/game_raylib.iron: Window lifecycle, a single
-- `while not Window.should_close()` loop, Keyboard polling, Draw.*
-- primitives, and Int → Int32 narrowing at the Draw.* call sites.

import raylib

object Player {
    var x: Int
    var y: Int
    val speed: Int
    val size: Int

    init(x: Int, y: Int) {
        self.x = x
        self.y = y
        self.speed = 6
        self.size = 24
    }

    func update(max_x: Int, max_y: Int) {
        if Keyboard.is_down(KeyboardKey.RIGHT) { self.x = self.x + self.speed }
        if Keyboard.is_down(KeyboardKey.LEFT)  { self.x = self.x - self.speed }
        if Keyboard.is_down(KeyboardKey.UP)    { self.y = self.y - self.speed }
        if Keyboard.is_down(KeyboardKey.DOWN)  { self.y = self.y + self.speed }

        -- Clamp to the screen.
        if self.x < 0 { self.x = 0 }
        if self.x > max_x - self.size { self.x = max_x - self.size }
        if self.y < 0 { self.y = 0 }
        if self.y > max_y - self.size { self.y = max_y - self.size }
    }

    readonly func draw() {
        Draw.rectangle(Int32(self.x), Int32(self.y),
                       Int32(self.size), Int32(self.size), WHITE)
    }
}

func main() {
    val SCREEN_W: Int = 800
    val SCREEN_H: Int = 600
    val COIN_R: Int = 10

    Window.init(Int32(SCREEN_W), Int32(SCREEN_H), "Iron Game")
    Window.set_target_fps(Int32(60))

    var player = Player(100, 100)
    var coin_x: Int = 600
    var coin_y: Int = 400
    var score: Int = 0

    while not Window.should_close() {
        player.update(SCREEN_W, SCREEN_H)

        -- Coin pickup: axis-aligned overlap test, then hop the coin to
        -- a new spot (deterministic walk kept inside the screen).
        if player.x + player.size > coin_x - COIN_R and player.x < coin_x + COIN_R {
            if player.y + player.size > coin_y - COIN_R and player.y < coin_y + COIN_R {
                score = score + 1
                coin_x = coin_x + 217
                coin_y = coin_y + 137
                if coin_x > SCREEN_W - COIN_R { coin_x = coin_x - (SCREEN_W - 2 * COIN_R) }
                if coin_y > SCREEN_H - COIN_R { coin_y = coin_y - (SCREEN_H - 2 * COIN_R) }
            }
        }

        -- Render.
        Draw.begin()
        Draw.clear(BLACK)
        player.draw()
        Draw.circle(Int32(coin_x), Int32(coin_y), Float32(10.0), GOLD)
        val score_str = "score: " + score.to_string()
        Draw.text(score_str, Int32(10), Int32(10), Int32(20), WHITE)
        Draw.end()
    }

    Window.close()
}
