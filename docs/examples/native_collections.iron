func main() {
    var counts = Map[String, Int]()
    for word in ["iron", "map", "iron", "set", "iron"] {
        counts.put(word, counts.get_or(word, 0) + 1)
    }
    var words = counts.keys()
    words.sort()
    for word in words {
        println("{word}={counts.get(word)}")
    }

    var seen = Set[Int]()
    for n in [3, 1, 3, 2, 1] {
        seen.add(n)
    }
    println("distinct={seen.len()} has2={seen.has(2)} has9={seen.has(9)}")
}
