-- Verified HTTPS REST client for the development certificate generated by
-- https_server.iron. Use Http.request for public certificates/system roots.
import http

func main() {
    val response = Http.request_with_ca(
        "POST",
        "https://localhost:8443/api/items",
        "Content-Type: application/json; charset=utf-8",
        "\{\"name\":\"anvil\"\}",
        1048576,
        "cert.pem",
        5000,
    )
    if response.error != 0 {
        println("HTTPS request failed: {response.error} {response.error_message}")
        return
    }
    println("HTTPS {response.status}: {response.body}")
}
