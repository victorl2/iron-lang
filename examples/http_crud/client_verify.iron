// client_verify.iron: second-phase client: runs after the server has
// been stopped and restarted, proving the binary store file actually
// persisted state across process death (not just in-memory CRUD).
//
// Expected store state on entry (left by client.iron):
//   exactly one live record: id 1, name "alpha-renamed", note "edited note"
//
// Sequence: verify survivor -> delete it -> verify empty -> shutdown.
import net

var g_pass = 0
var g_fail = 0

val g_host = "127.0.0.1"
val g_port = 8471

// Byte offset of the first occurrence of needle in s, or -1. String
// positions count characters, and response bodies may hold any bytes.
func byte_index_of(s: String, needle: String) -> Int {
    val n = s.byte_len()
    val m = needle.byte_len()
    var i = 0
    while i + m <= n {
        var j = 0
        while j < m and s.byte_at(i + j) == needle.byte_at(j) {
            j = j + 1
        }
        if j == m {
            return i
        }
        i = i + 1
    }
    return -1
}

// One full request/response cycle; returns the raw response ("" on error).
func http_request(method: String, path: String, body: String) -> String {
    val (sock, derr) = Net.tcp_dial(g_host, g_port, 3000)
    if derr.code != 0 {
        println("dial failed: {derr.code}")
        return ""
    }
    val blen = body.byte_len()
    val req = "{method} {path} HTTP/1.1\u{D}\n"
        + "Host: {g_host}\u{D}\n"
        + "Content-Length: {blen}\u{D}\n"
        + "Connection: close\u{D}\n"
        + "\u{D}\n"
        + body
    val (nw, werr) = TcpSocket.write(sock, req, 3000)
    if werr.code != 0 or nw != req.byte_len() {
        println("send failed: {werr.code} sent={nw}")
        TcpSocket.close(sock)
        return ""
    }
    // The server closes the connection after responding: read until EOF.
    var chunks: [String] = []
    while true {
        val (chunk, rerr) = TcpSocket.read(sock, 65536, 5000)
        if rerr.code != 0 or chunk.byte_len() == 0 {
            break
        }
        chunks.push(chunk)
    }
    TcpSocket.close(sock)
    return "".join(chunks)
}

func status_of(resp: String) -> Int {
    if resp.byte_len() < 12 {
        return 0
    }
    return resp.byte_slice(9, 12).to_int()
}

func body_of(resp: String) -> String {
    val i = byte_index_of(resp, "\u{D}\n\u{D}\n")
    if i < 0 {
        return ""
    }
    return resp.byte_slice(i + 4, resp.byte_len())
}

func check(label: String, cond: Bool) {
    if cond {
        g_pass = g_pass + 1
        println("ok - {label}")
    } else {
        g_fail = g_fail + 1
        println("FAIL - {label}")
    }
}

func main() {
    println("verify: checking persisted state after server restart")

    val r1 = http_request("GET", "/records", "")
    check("list -> 200", status_of(r1) == 200)
    val listing = body_of(r1)
    check("one record survived restart", listing.starts_with("1\n"))
    check("survivor is renamed alpha", listing.contains("1|alpha-renamed"))

    val r2 = http_request("GET", "/records/1", "")
    check("survivor body intact", body_of(r2) == "1\nalpha-renamed\nedited note\n")

    val r3 = http_request("DELETE", "/records/1", "")
    check("delete survivor -> 204", status_of(r3) == 204)

    val r4 = http_request("GET", "/records", "")
    check("store empty after delete", body_of(r4).starts_with("0\n"))

    val r5 = http_request("GET", "/shutdown", "")
    check("shutdown -> 200", status_of(r5) == 200)

    println("verify: {g_pass} passed, {g_fail} failed")
    if g_fail == 0 {
        println("ALL CHECKS PASSED")
    }
}
